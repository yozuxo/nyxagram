diff --git a/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/NyxaAppearance.swift b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/NyxaAppearance.swift
