+    public static func profileGifts(accountPeerId: EnginePeer.Id, accountPeer: EnginePeer?) -> [ProfileGiftsContext.State.StarGift] {
+        let all = entries(accountPeerId: accountPeerId)
+        let pinned = pinnedIds(accountPeerId: accountPeerId)
+        let ordered = pinned.compactMap { id in all.first(where: { $0.id == id }) } + all.filter { !pinned.contains($0.id) }
+        return ordered.map { entry in
+            return stateGift(entry: entry, accountPeerId: accountPeerId, fromPeer: accountPeer)
+        }
+    }
+    
+    static func stateGift(entry: NyxaFakeGiftEntry, accountPeerId: EnginePeer.Id, fromPeer: EnginePeer?) -> ProfileGiftsContext.State.StarGift {
+        var canUpgrade = false
+        if notUpgraded, case let .generic(gift) = entry.gift, gift.upgradeStars != nil {
+            canUpgrade = true
+        }
+        return ProfileGiftsContext.State.StarGift(
+            gift: ownedGift(entry.gift, accountPeerId: accountPeerId),
+            reference: .peer(peerId: accountPeerId, id: entry.id),
+            fromPeer: fromPeer,
+            date: entry.date,
