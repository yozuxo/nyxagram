+    static func attachMessage(entryId: Int64, messageId: Int32, accountPeerId: EnginePeer.Id) {
+        var entries = self.entries(accountPeerId: accountPeerId)
+        guard let index = entries.firstIndex(where: { $0.id == entryId }) else {
