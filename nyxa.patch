+            logo.frame = CGRect(x: 3.0, y: 2.5, width: 7.0, height: 8.0)
+            badge.addSubview(logo)
+            view.addSubview(badge)
+        }
+        badge.frame = CGRect(x: size.width - 13.0 - 6.0, y: size.height - 13.0 - 6.0, width: 13.0, height: 13.0)
+        view.bringSubviewToFront(badge)
+    } else {
+        existing?.removeFromSuperview()
+    }
+}
