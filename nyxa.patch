+func _internal_nyxaPostFakeGiftMessage(account: Account, entryId: Int64, gift: StarGift) -> Signal<Never, NoError> {
+    let accountPeerId = account.peerId
+    return account.postbox.transaction { transaction -> Void in
+        let action = nyxaGiftAction(gift: gift, accountPeerId: accountPeerId)
+        let randomId = Int64.random(in: Int64.min ... Int64.max)
+        let timestamp = Int32(clamping: Int64(Date().timeIntervalSince1970))
+        let message = StoreMessage(peerId: accountPeerId, namespace: Namespaces.Message.Local, customStableId: nil, globallyUniqueId: randomId, groupingKey: nil, threadId: nil, timestamp: timestamp, flags: [], tags: [], globalTags: [], localTags: [], forwardInfo: nil, authorId: accountPeerId, text: "", attributes: [], media: [
+            TelegramMediaAction(action: action)
+        ])
+        guard let id = transaction.addMessages([message], location: .Random)[randomId] else {
+            return
+        }
+        NyxaFakeGifts.attachMessage(entryId: entryId, messageId: id.id, accountPeerId: accountPeerId)
+    }
+    |> ignoreValues
+}
+
+func _internal_nyxaDeleteFakeGiftMessages(account: Account, ids: [MessageId]) -> Signal<Never, NoError> {
+    return account.postbox.transaction { transaction -> Void in
+        transaction.deleteMessages(ids, forEachMedia: nil)
+    }
+    |> ignoreValues
+}
+
+func nyxaFakeUpgradeForm(accountPeerId: PeerId, reference: StarGiftReference) -> BotPaymentForm {
+    var price: Int64 = 0
+    if NyxaSettings.fakeStarsEnabled, let entry = NyxaFakeGifts.entry(for: reference, accountPeerId: accountPeerId), case let .generic(base) = entry.gift {
+        price = base.upgradeStars ?? 0
+    }
+    return BotPaymentForm(
+        id: 0,
+        canSaveCredentials: false,
+        passwordMissing: false,
+        invoice: BotPaymentInvoice(isTest: false, requestedFields: [], currency: "XTR", prices: [BotPaymentPrice(label: "Upgrade", amount: price)], tip: nil, termsInfo: nil, subscriptionPeriod: nil),
+        paymentBotId: nil,
+        providerId: nil,
+        url: nil,
+        nativeProvider: nil,
+        savedInfo: nil,
+        savedCredentials: [],
+        additionalPaymentMethods: []
+    )
+}
+
+private func nyxaHasAllVariantKinds(_ attributes: [StarGift.UniqueGift.Attribute]) -> Bool {
+    var hasModel = false
+    var hasPattern = false
+    var hasBackdrop = false
+    for attribute in attributes {
+        switch attribute {
+        case .model:
+            hasModel = true
+        case .pattern:
+            hasPattern = true
+        case .backdrop:
+            hasBackdrop = true
+        case .originalInfo:
+            break
+        }
+    }
+    return hasModel && hasPattern && hasBackdrop
+}
+
+private func nyxaUpgradeVariants(account: Account, giftId: Int64) -> Signal<[StarGift.UniqueGift.Attribute], NoError> {
+    let list = _internal_getStarGiftUpgradeAttributes(account: account, giftId: giftId)
+    |> map { $0 ?? [] }
+    |> filter { !$0.isEmpty }
+    |> map(Optional.init)
+    |> take(1)
+    |> then(Signal<[StarGift.UniqueGift.Attribute]?, NoError>.single(nil))
+    |> take(1)
+    return list
+    |> mapToSignal { attributes -> Signal<[StarGift.UniqueGift.Attribute], NoError> in
+        let known = attributes ?? []
+        if nyxaHasAllVariantKinds(known) {
+            return .single(known)
+        }
+        return _internal_starGiftUpgradePreview(account: account, giftId: giftId)
+        |> map { preview -> [StarGift.UniqueGift.Attribute] in
+            return known + (preview?.attributes ?? [])
+        }
+    }
+}
