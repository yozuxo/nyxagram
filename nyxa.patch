+            }
+        })
+        presentImpl?(prompt)
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        currentPromise.get()
+    )
+    |> map { presentationData, current -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [NyxaDeviceEntry] = [.header(isRussian ? "НАЗВАНИЕ В СЕАНСАХ" : "NAME IN SESSIONS")]
+        entries.append(.option(0, isRussian ? "Настоящее устройство" : "Real Device", nil, current == nil))
+        entries.append(.option(1, isRussian ? "Скрыть устройство" : "Hide Device", hiddenName, current == hiddenName))
+        var isPreset = current == nil || current == hiddenName
+        for (index, preset) in nyxaDevicePresets.enumerated() {
+            entries.append(.option(Int32(2 + index), preset, preset, current == preset))
+            if current == preset {
