+func _internal_nyxaUpgradeFakeGift(account: Account, reference: StarGiftReference, keepOriginalInfo: Bool) -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> {
+    let accountPeerId = account.peerId
+    guard let entry = NyxaFakeGifts.entry(for: reference, accountPeerId: accountPeerId), case let .generic(base) = entry.gift else {
+        return .fail(.generic)
+    }
+    let entryId = entry.id
+    return nyxaUpgradeVariants(account: account, giftId: base.id)
+    |> castError(UpgradeStarGiftError.self)
+    |> mapToSignal { attributes -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+        let models = attributes.filter { if case .model = $0 { return true } else { return false } }
+        let patterns = attributes.filter { if case .pattern = $0 { return true } else { return false } }
+        let backdrops = attributes.filter { if case .backdrop = $0 { return true } else { return false } }
+        guard let model = models.randomElement(), let pattern = patterns.randomElement(), let backdrop = backdrops.randomElement() else {
+            return .fail(.generic)
+        }
+        var uniqueAttributes: [StarGift.UniqueGift.Attribute] = [model, pattern, backdrop]
+        if keepOriginalInfo {
+            uniqueAttributes.append(.originalInfo(senderPeerId: accountPeerId, recipientPeerId: accountPeerId, date: entry.date, text: nil, entities: nil))
+        }
+        
+        let supply: Int32
+        if let total = base.availability?.total, total > 0 {
+            supply = total
+        } else {
+            supply = 100000
+        }
+        let number = Int32.random(in: 1 ... supply)
+        let title = base.title ?? "Gift"
+        let slugTitle = title.filter { $0.isLetter || $0.isNumber }
+        let unique = StarGift.UniqueGift(
+            id: Int64.random(in: 1 ... Int64.max),
+            giftId: base.id,
+            title: title,
+            number: number,
+            slug: (slugTitle.isEmpty ? "Gift" : slugTitle) + "-\(number)",
+            owner: .peerId(accountPeerId),
+            attributes: uniqueAttributes,
+            availability: StarGift.UniqueGift.Availability(issued: number, total: supply),
+            giftAddress: nil,
+            resellAmounts: nil,
+            resellForTonOnly: false,
+            releasedBy: base.releasedBy,
+            valueAmount: nil,
+            valueCurrency: nil,
+            valueUsdAmount: nil,
+            flags: [],
+            themePeerId: nil,
+            peerColor: nil,
+            hostPeerId: nil,
+            minOfferStars: nil,
+            craftChancePermille: nil
+        )
+        let upgradePrice = base.upgradeStars ?? 0
+        if !NyxaSettings.spendFakeStars(upgradePrice) {
+            return .fail(.generic)
+        }
+        NyxaFakeHistory.record(accountPeerId: accountPeerId, kind: .upgrade, gift: .unique(unique), stars: upgradePrice, gramNanos: 0)
+        NyxaFakeGifts.replaceGift(entryId: entryId, gift: .unique(unique), accountPeerId: accountPeerId)
+        guard let updated = NyxaFakeGifts.entries(accountPeerId: accountPeerId).first(where: { $0.id == entryId }) else {
+            return .fail(.generic)
+        }
+        let result = NyxaFakeGifts.stateGift(entry: updated, accountPeerId: accountPeerId, fromPeer: nil)
+        return account.postbox.transaction { transaction -> Void in
+            guard let localId = updated.messageId else {
+                return
+            }
+            let messageId = MessageId(peerId: accountPeerId, namespace: Namespaces.Message.Local, id: localId)
+            guard let message = transaction.getMessage(messageId) else {
+                return
+            }
+            let media: [Media] = [TelegramMediaAction(action: nyxaGiftAction(gift: updated.gift, accountPeerId: accountPeerId))]
+            transaction.updateMessage(messageId, update: { _ in
+                return .update(StoreMessage(id: message.id, customStableId: nil, globallyUniqueId: message.globallyUniqueId, groupingKey: message.groupingKey, threadId: message.threadId, timestamp: message.timestamp, flags: StoreMessageFlags(message.flags), tags: message.tags, globalTags: message.globalTags, localTags: message.localTags, forwardInfo: nil, authorId: message.author?.id, text: message.text, attributes: message.attributes, media: media))
+            })
+        }
+        |> castError(UpgradeStarGiftError.self)
+        |> map { _ -> ProfileGiftsContext.State.StarGift in
+            return result
+        }
+    }
+}
