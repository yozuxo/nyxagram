@@ -0,0 +1,72 @@
+import Foundation
+import UIKit
+import Display
+
+private let nyxaStreakPalettes: [(UIColor, UIColor)] = [
+    (UIColor(rgb: 0xFFC53D), UIColor(rgb: 0xFF6A00)),
+    (UIColor(rgb: 0xFF8A3D), UIColor(rgb: 0xE3170A)),
+    (UIColor(rgb: 0xFF6FB5), UIColor(rgb: 0xE0115F)),
+    (UIColor(rgb: 0xD58CFF), UIColor(rgb: 0x8A2BE2)),
+    (UIColor(rgb: 0x8FA8FF), UIColor(rgb: 0x3D5AFE)),
+    (UIColor(rgb: 0x7FE7FF), UIColor(rgb: 0x0091EA)),
+    (UIColor(rgb: 0x9BFFB0), UIColor(rgb: 0x00B248)),
+    (UIColor(rgb: 0xE4FF7A), UIColor(rgb: 0x7CB342)),
+    (UIColor(rgb: 0xFFE57A), UIColor(rgb: 0xFFA000)),
+    (UIColor(rgb: 0xFFF3B0), UIColor(rgb: 0xC79100)),
+    (UIColor(rgb: 0xFFB199), UIColor(rgb: 0xB71C1C)),
+    (UIColor(rgb: 0xFF9AE0), UIColor(rgb: 0x6A1B9A)),
+    (UIColor(rgb: 0xA6FFF2), UIColor(rgb: 0x00897B)),
+    (UIColor(rgb: 0xB3C7FF), UIColor(rgb: 0x1A237E)),
+    (UIColor(rgb: 0xFFD1A6), UIColor(rgb: 0xBF360C)),
+    (UIColor(rgb: 0xE6D1FF), UIColor(rgb: 0x4A148C)),
+    (UIColor(rgb: 0xFFE0F0), UIColor(rgb: 0xAD1457))
+]
+
+private var nyxaStreakBadgeCache: [String: UIImage] = [:]
+
+public func nyxaStreakBadgeImage(days: Int, isDark: Bool) -> UIImage? {
+    let key = "\(days)-\(isDark)"
+    if let cached = nyxaStreakBadgeCache[key] {
+        return cached
+    }
+    let isLegend = days >= 500
+    let palette = nyxaStreakPalettes[min(max(0, (days - 1) / 30), nyxaStreakPalettes.count - 1)]
+    let topColor = isLegend ? UIColor.white : palette.0
+    let bottomColor = isLegend ? UIColor(rgb: 0x2C2C2E) : palette.1
+    let numberColor = isLegend ? (isDark ? UIColor.white : UIColor.black) : palette.1
+    
+    guard let symbol = UIImage(systemName: "flame.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 13.0, weight: .semibold))?.withTintColor(.white, renderingMode: .alwaysOriginal) else {
+        return nil
+    }
+    let number = NSAttributedString(string: "\(days)", attributes: [
+        .font: UIFont.systemFont(ofSize: 13.0, weight: .bold),
+        .foregroundColor: numberColor
+    ])
+    let numberSize = number.size()
+    let flameSize = symbol.size
+    let height = max(ceil(flameSize.height), ceil(numberSize.height)) + 2.0
+    let size = CGSize(width: ceil(flameSize.width) + 2.0 + ceil(numberSize.width) + 2.0, height: height)
+    
+    let flameRect = CGRect(x: 1.0, y: floor((height - flameSize.height) / 2.0), width: flameSize.width, height: flameSize.height)
+    
+    let flame = UIGraphicsImageRenderer(size: size).image { context in
+        symbol.draw(in: flameRect)
+        context.cgContext.setBlendMode(.sourceIn)
+        let colors = [topColor.cgColor, bottomColor.cgColor] as CFArray
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0.0, 1.0]) {
+            context.cgContext.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: flameRect.minY), end: CGPoint(x: 0.0, y: flameRect.maxY), options: [])
+        }
+    }
+    let image = UIGraphicsImageRenderer(size: size).image { _ in
+        if isLegend {
+            symbol.withTintColor(UIColor(rgb: 0x8E8E93), renderingMode: .alwaysOriginal).draw(in: flameRect.insetBy(dx: -0.8, dy: -0.8))
+        }
+        flame.draw(at: .zero)
+        number.draw(at: CGPoint(x: flameRect.maxX + 2.0, y: floor((height - numberSize.height) / 2.0)))
+    }
+    if nyxaStreakBadgeCache.count > 400 {
+        nyxaStreakBadgeCache.removeAll()
+    }
+    nyxaStreakBadgeCache[key] = image
+    return image
+}
