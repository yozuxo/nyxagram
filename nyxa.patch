+- (void)nyxaRunLightning
+{
+    if (!_nyxaEffectsRunning) {
+        return;
+    }
+    CAKeyframeAnimation *flash = [CAKeyframeAnimation animationWithKeyPath:@"opacity"];
+    flash.values = @[@0.0, @0.16, @0.02, @0.1, @0.0];
+    flash.keyTimes = @[@0.0, @0.08, @0.2, @0.3, @1.0];
+    flash.duration = 0.9;
+    [_nyxaFlashView.layer addAnimation:flash forKey:@"nyxaLightning"];
+    
+    CAKeyframeAnimation *glow = [CAKeyframeAnimation animationWithKeyPath:@"shadowOpacity"];
+    glow.values = @[@0.35, @1.0, @0.6, @0.9, @0.35];
+    glow.keyTimes = @[@0.0, @0.08, @0.2, @0.3, @1.0];
+    CAKeyframeAnimation *glowRadius = [CAKeyframeAnimation animationWithKeyPath:@"shadowRadius"];
+    glowRadius.values = @[@10.0, @26.0, @16.0, @22.0, @10.0];
+    glowRadius.keyTimes = glow.keyTimes;
+    CAKeyframeAnimation *pulse = [CAKeyframeAnimation animationWithKeyPath:@"transform.scale"];
+    pulse.values = @[@1.0, @1.06, @1.0];
+    pulse.keyTimes = @[@0.0, @0.15, @1.0];
+    CAAnimationGroup *logoGroup = [CAAnimationGroup animation];
+    logoGroup.animations = @[glow, glowRadius, pulse];
+    logoGroup.duration = 1.4;
+    [_nyxaLogoView.layer addAnimation:logoGroup forKey:@"nyxaFlare"];
+    
+    __weak RMIntroViewController *weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        __strong RMIntroViewController *strongSelf = weakSelf;
+        if (strongSelf != nil && strongSelf->_nyxaEffectsRunning) {
+            [strongSelf->_nyxaThunderPlayer stop];
+            strongSelf->_nyxaThunderPlayer.currentTime = 0.0;
+            [strongSelf->_nyxaThunderPlayer play];
+        }
+    });
+}
