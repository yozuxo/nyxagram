+        entries.append(.custom(isRussian ? "Своё название…" : "Custom Name…", isPreset ? "" : (current ?? "")))
+        entries.append(.footer(isRussian ? "Telegram покажет это название в Настройки → Устройства. Применится после перезапуска." : "Telegram shows this name in Settings → Devices. Applies after a restart."))
