+    @discardableResult
+    public static func add(gift: StarGift, accountPeerId: EnginePeer.Id) -> Int64 {
+        var entries = self.entries(accountPeerId: accountPeerId)
+        let id = -(Int64(Date().timeIntervalSince1970 * 1000.0) * 1000 + Int64.random(in: 0 ..< 1000))
+        entries.insert(NyxaFakeGiftEntry(id: id, gift: gift, date: Int32(Date().timeIntervalSince1970), messageId: nil), at: 0)
+        store(entries, accountPeerId: accountPeerId)
