+func nyxaPlayPremiumBadgeAnimation(on view: UIView) {
+    let bounce = CAKeyframeAnimation(keyPath: "transform.scale")
+    bounce.values = [1.0, 1.45, 0.9, 1.1, 1.0]
+    bounce.keyTimes = [0.0, 0.3, 0.55, 0.8, 1.0]
+    bounce.duration = 0.6
+    view.layer.add(bounce, forKey: "nyxaBounce")
+    
+    let spin = CABasicAnimation(keyPath: "transform.rotation.z")
+    spin.fromValue = 0.0
+    spin.toValue = CGFloat.pi * 2.0
+    spin.duration = 0.6
+    spin.timingFunction = CAMediaTimingFunction(name: .easeOut)
+    view.layer.add(spin, forKey: "nyxaSpin")
+    
+    guard let container = view.window else {
+        return
+    }
+    let center = view.convert(CGPoint(x: view.bounds.midX, y: view.bounds.midY), to: container)
+    let colors: [UIColor] = [UIColor(red: 0.76, green: 0.42, blue: 1.0, alpha: 1.0), UIColor(red: 1.0, green: 0.85, blue: 0.4, alpha: 1.0), UIColor.white]
+    for i in 0 ..< 14 {
+        let dot = UIView(frame: CGRect(x: 0.0, y: 0.0, width: 6.0, height: 6.0))
+        dot.backgroundColor = colors[i % colors.count]
+        dot.layer.cornerRadius = 3.0
+        dot.center = center
+        dot.isUserInteractionEnabled = false
+        container.addSubview(dot)
+        let angle = CGFloat(i) / 14.0 * CGFloat.pi * 2.0
+        let distance = CGFloat.random(in: 34.0 ... 60.0)
+        UIView.animate(withDuration: 0.7, delay: 0.0, options: [.curveEaseOut], animations: {
+            dot.center = CGPoint(x: center.x + cos(angle) * distance, y: center.y + sin(angle) * distance)
+            dot.alpha = 0.0
+            dot.transform = CGAffineTransform(scaleX: 0.3, y: 0.3)
+        }, completion: { _ in
+            dot.removeFromSuperview()
+        })
+    }
+    UIImpactFeedbackGenerator(style: .light).impactOccurred()
+}
