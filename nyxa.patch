+    static func replaceGift(entryId: Int64, gift: StarGift, accountPeerId: EnginePeer.Id) {
+        var entries = self.entries(accountPeerId: accountPeerId)
+        guard let index = entries.firstIndex(where: { $0.id == entryId }) else {
+            return
+        }
+        let entry = entries[index]
+        entries[index] = NyxaFakeGiftEntry(id: entry.id, gift: gift, date: entry.date, messageId: entry.messageId)
+        store(entries, accountPeerId: accountPeerId)
+    }
