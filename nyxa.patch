+private enum NyxaMainEntry: ItemListNodeEntry {
+    case groupHeader(Int32, String)
+    case groupFooter(Int32, String)
+    case deleted(String, String)
+    case ghost(String, String)
+    case fakePhone(String, String)
+    case fakeUsernames(String, String)
+    case streaks(String, String)
+    case device(String, String)
+    case fakeGifts(String, String)
+    case fakeStars(String, String)
+    case notUpgraded(String, String)
+    case localPremium(String, String)
+    case findById(String, String)
+    case deviceTranslation(String, String)
+    case autocorrect(String, String)
+    case toggle(NyxaToggle, String, String, Bool)
+    case frames(String, String)
+    case banner(String, String)
+    case backupExport(String)
+    case backupImport(String)
+
+    var section: ItemListSectionId {
+        switch self.stableId {
+        case ..<(-160):
+            return 0
+        case ..<(-80):
+            return 1
+        case ..<0:
+            return 2
+        case ..<10:
+            return 3
+        case ..<20:
+            return 4
+        case ..<30:
+            return 5
+        default:
+            return 6
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .groupHeader(id, _), let .groupFooter(id, _):
+            return id
+        case .deleted:
+            return -190
+        case .ghost:
+            return -180
+        case .fakePhone:
+            return -150
+        case .fakeUsernames:
+            return -140
+        case .fakeGifts:
+            return -130
+        case .notUpgraded:
+            return -120
+        case .fakeStars:
+            return -110
+        case .localPremium:
+            return -100
+        case .streaks:
+            return -70
+        case .device:
+            return -60
+        case .findById:
+            return -50
+        case .deviceTranslation:
+            return -40
+        case .autocorrect:
+            return -30
+        case let .toggle(toggle, _, _, _):
+            return toggle.mainOrder
+        case .frames:
+            return 21
+        case .banner:
+            return 22
+        case .backupExport:
+            return 31
+        case .backupImport:
+            return 32
+        }
+    }
+
+    static func <(lhs: NyxaMainEntry, rhs: NyxaMainEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! NyxaMainArguments
+        switch self {
+        case let .groupHeader(_, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .groupFooter(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .deleted(title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: NyxaIcons.deleted, title: title, label: label, sectionId: self.section, style: .blocks, action: {
+                arguments.openDeleted()
+            })
+        case let .ghost(title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: NyxaIcons.ghost, title: title, label: label, sectionId: self.section, style: .blocks, action: {
+                arguments.openGhost()
+            })
+        case let .fakePhone(title, label):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: NyxaIcons.fakePhone, title: title, label: label, sectionId: self.section, style: .blocks, action: {
+                arguments.openFakePhone()
