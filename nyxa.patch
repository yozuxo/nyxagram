+            let baseY = center.y - radius + lineWidth * 0.2
+            let left = center.x - crownWidth / 2.0
+            let crown = UIBezierPath()
+            crown.move(to: CGPoint(x: left, y: baseY))
+            crown.addLine(to: CGPoint(x: left - crownWidth * 0.04, y: baseY - crownHeight))
+            crown.addLine(to: CGPoint(x: left + crownWidth * 0.28, y: baseY - crownHeight * 0.55))
+            crown.addLine(to: CGPoint(x: center.x, y: baseY - crownHeight * 1.15))
+            crown.addLine(to: CGPoint(x: left + crownWidth * 0.72, y: baseY - crownHeight * 0.55))
+            crown.addLine(to: CGPoint(x: left + crownWidth * 1.04, y: baseY - crownHeight))
+            crown.addLine(to: CGPoint(x: left + crownWidth, y: baseY))
