+        NyxaSettings.fakeStarsEnabled = value
+        statePromise.set(nyxaCurrentFakeStarsState())
+    }, updateStars: { progress in
+        let amount = nyxaFakeBalanceAmount(progress: progress)
+        if amount != NyxaSettings.fakeStars {
+            NyxaSettings.fakeStars = amount
+            statePromise.set(nyxaCurrentFakeStarsState())
+        }
+    }, toggleGram: { value in
+        NyxaSettings.fakeGramEnabled = value
+        statePromise.set(nyxaCurrentFakeStarsState())
+    }, updateGram: { progress in
+        let amount = nyxaFakeBalanceAmount(progress: progress)
+        if amount != NyxaSettings.fakeGram {
+            NyxaSettings.fakeGram = amount
+            statePromise.set(nyxaCurrentFakeStarsState())
+        }
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        statePromise.get()
