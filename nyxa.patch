+            context.strokePath()
+        case .nyxa:
+            context.setStrokeColor(UIColor.white.cgColor)
+            context.setLineWidth(lineWidth)
+            context.addPath(ring.cgPath)
+            context.strokePath()
+            context.setLineWidth(lineWidth * 0.35)
