+private func nyxaSwitchController(context: AccountContext, title: String, switchTitle: String, footer: String, details: (header: String, rows: [NyxaSwitchDetail])? = nil, icon: UIImage?, value: @escaping () -> Bool, update: @escaping (Bool) -> Void) -> ViewController {
+    let enabledPromise = ValuePromise<Bool>(value(), ignoreRepeated: true)
+    let arguments = NyxaSwitchArguments(icon: icon, toggle: { newValue in
+        update(newValue)
+        enabledPromise.set(newValue)
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        enabledPromise.get()
+    )
+    |> map { presentationData, enabled -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [NyxaSwitchEntry] = [.toggle(switchTitle, enabled)]
+        if let details {
+            entries.append(.detailHeader(details.header))
+            for (index, row) in details.rows.enumerated() {
+                entries.append(.detail(Int32(index), row))
+            }
+            entries.append(.detailFooter(footer))
+        } else {
+            entries.append(.footer(footer))
+        }
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
