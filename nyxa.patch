+public enum NyxaChatLock {
+    private static let lock = NSLock()
+    private static var unlockedPeerIds = Set<Int64>()
+    private static var backgroundObserver: NSObjectProtocol?
+    
+    public static var lockedPeerIds: Set<Int64> {
+        return nyxaPeerIds(forKey: "nyxa.lockedChats")
+    }
+    
+    public static func isLocked(peerId: EnginePeer.Id) -> Bool {
+        return lockedPeerIds.contains(peerId.toInt64())
+    }
+    
+    public static func setLocked(_ locked: Bool, peerId: EnginePeer.Id) {
+        var peerIds = lockedPeerIds
+        if locked {
+            peerIds.insert(peerId.toInt64())
+        } else {
+            peerIds.remove(peerId.toInt64())
+        }
+        nyxaSetPeerIds(peerIds, forKey: "nyxa.lockedChats")
+        NotificationCenter.default.post(name: NyxaSettings.chatListDidChangeNotification, object: nil)
+    }
+    
+    public static func needsUnlock(peerId: EnginePeer.Id) -> Bool {
+        if !isLocked(peerId: peerId) {
+            return false
+        }
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        return !unlockedPeerIds.contains(peerId.toInt64())
+    }
+    
+    public static func markUnlocked(peerId: EnginePeer.Id) {
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        unlockedPeerIds.insert(peerId.toInt64())
+        if backgroundObserver == nil {
+            backgroundObserver = NotificationCenter.default.addObserver(forName: Notification.Name("UIApplicationDidEnterBackgroundNotification"), object: nil, queue: nil, using: { _ in
+                NyxaChatLock.lock.lock()
+                NyxaChatLock.unlockedPeerIds.removeAll()
+                NyxaChatLock.lock.unlock()
+            })
+        }
+    }
+}
