+func nyxaSettingsController(context: AccountContext) -> ViewController {
+    let store = NyxaSettingsStore()
+    let strings = NyxaStrings.make()
+    let isRussian = nyxaIsRussianLocale()
+
+    var pushImpl: ((ViewController) -> Void)?
+    var presentImpl: ((ViewController) -> Void)?
+    var navigationImpl: (() -> NavigationController?)?
+
+    let arguments = NyxaMainArguments(
+        openDeleted: {
+            pushImpl?(nyxaDeletedMessagesController(context: context, store: store, strings: strings))
+        },
+        openGhost: {
+            pushImpl?(nyxaGhostModeController(context: context, store: store, strings: strings))
+        },
+        openFakePhone: {
+            pushImpl?(nyxaFakePhoneController(context: context, store: store, strings: strings))
+        },
+        openFakeUsernames: {
+            pushImpl?(nyxaFakeUsernamesController(context: context, store: store, strings: strings))
+        },
+        openStreaks: {
+            pushImpl?(nyxaStreaksController(context: context, strings: strings))
+        },
+        openDevice: {
+            pushImpl?(nyxaDeviceController(context: context))
+        },
+        openFakeGifts: {
+            pushImpl?(nyxaFakeGiftsController(context: context))
+        },
+        openFakeStars: {
+            pushImpl?(nyxaFakeStarsController(context: context))
+        },
+        openNotUpgraded: {
+            pushImpl?(nyxaNotUpgradedGiftsController(context: context))
+        },
+        openLocalPremium: {
+            pushImpl?(nyxaLocalPremiumController(context: context))
+        },
+        openDeviceTranslation: {
+            pushImpl?(nyxaDeviceTranslationController(context: context))
+        },
+        openAutocorrect: {
+            pushImpl?(nyxaAutocorrectController(context: context))
+        },
+        openFindById: {
+            let prompt = promptController(context: context, text: isRussian ? "Поиск по ID" : "Find by ID", subtitle: isRussian ? "Откроет профиль или чат по числовому ID, если приложение его знает" : "Opens a profile or chat by its numeric ID if the app knows it", value: "", placeholder: "123456789", characterLimit: 24, apply: { value in
+                guard let value, !value.isEmpty else {
+                    return
+                }
+                nyxaOpenPeer(byId: value, context: context, navigationController: navigationImpl?(), present: { c in
+                    presentImpl?(c)
+                })
+            })
+            presentImpl?(prompt)
+        },
+        toggle: { toggle, value in
+            store.update { state in
+                state[keyPath: toggle.keyPath] = value
+            }
+        },
+        exportBackup: {
+            NyxaBackupPicker.share(from: (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController)
+        },
+        importBackup: {
+            NyxaBackupPicker.restore(from: (context.sharedContext.mainWindow?.viewController as? NavigationController)?.topViewController, completion: { result in
+                let text: String
+                switch result {
+                case let .restored(count):
+                    text = isRussian ? "Восстановлено настроек: \(count). Перезапустите приложение, чтобы всё применилось." : "\(count) settings restored. Restart the app to apply everything."
+                case .notABackup:
+                    text = isRussian ? "Это не бэкап Nyxagram." : "This isn't a Nyxagram backup."
+                case .unreadable:
+                    text = isRussian ? "Не удалось прочитать файл." : "Couldn't read the file."
+                }
+                let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+                presentImpl?(textAlertController(context: context, title: nil, text: text, actions: [
+                    TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+                ]))
+            })
+        },
+        openFrames: {
+            pushImpl?(nyxaFramesController(context: context, strings: strings))
+        },
+        openBanner: {
+            pushImpl?(nyxaBannerController(context: context, strings: strings))
+        }
+    )
+
+    let appearanceRevision = ValuePromise<Int>(0, ignoreRepeated: true)
+    let appearanceObserver = NyxaNotificationObserver(names: [NyxaAppearanceSettings.didChangeNotification, NyxaStreaks.didChangeNotification, NyxaFakeGifts.didChangeNotification, NyxaSettings.fakeBalanceDidChangeNotification, NyxaLocalPremium.didChangeNotification, NyxaSettings.deviceTranslationDidChangeNotification, NyxaSettings.autocorrectDidChangeNotification], action: { revision in
+        appearanceRevision.set(revision)
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        store.statePromise.get(),
+        appearanceRevision.get()
+    )
+    |> map { presentationData, state, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let _ = appearanceObserver
+        let entries: [NyxaMainEntry] = [
+            .groupHeader(-200, isRussian ? "ПРИВАТНОСТЬ" : "PRIVACY"),
+            .deleted(strings.deletedTitle, nyxaCountLabel(enabled: state.deletedEnabledCount, total: 2, strings: strings)),
+            .ghost(strings.ghostTitle, nyxaCountLabel(enabled: state.ghostEnabledCount, total: 5, strings: strings)),
+            .groupFooter(-170, isRussian ? "Что собеседники видят о вас и что остаётся у вас после удаления." : "What people see about you and what stays with you after deletion."),
+            .groupHeader(-160, isRussian ? "ФЕЙК: ВИДНО ТОЛЬКО ВАМ" : "FAKE: ONLY YOU SEE IT"),
+            .fakePhone(strings.fakePhoneTitle, state.fakePhone ? strings.on : strings.off),
+            .fakeUsernames(strings.fakeUsernamesTitle, state.fakeUsernames ? strings.on : strings.off),
+            .fakeGifts(isRussian ? "Fake подарки" : "Fake Gifts", NyxaFakeGifts.enabled ? strings.on : strings.off),
+            .notUpgraded(isRussian ? "Неулучшенные подарки" : "Not Upgraded Gifts", NyxaFakeGifts.notUpgraded ? strings.on : strings.off),
+            .fakeStars(isRussian ? "Фейк звёзды" : "Fake Stars", nyxaCountLabel(enabled: (NyxaSettings.fakeStarsEnabled ? 1 : 0) + (NyxaSettings.fakeGramEnabled ? 1 : 0), total: 2, strings: strings)),
+            .localPremium(isRussian ? "Локальный премиум" : "Local Premium", NyxaLocalPremium.enabled ? strings.on : strings.off),
+            .groupFooter(-90, isRussian ? "Это только на вашем устройстве. Другим людям ничего из этого не показывается." : "This lives on your device only. Nobody else sees any of it."),
+            .groupHeader(-80, isRussian ? "ИНСТРУМЕНТЫ" : "TOOLS"),
+            .streaks(strings.streaksTitle, NyxaStreaks.enabled ? strings.on : strings.off),
+            .device(isRussian ? "Подмена устройства" : "Device Spoofing", NyxaSettings.deviceModelOverride ?? strings.off),
+            .findById(isRussian ? "Поиск по ID" : "Find by ID", ""),
+            .deviceTranslation(isRussian ? "Переводчик" : "Translator", NyxaSettings.deviceTranslation ? strings.on : strings.off),
+            .autocorrect(isRussian ? "Автоисправление" : "Autocorrect", NyxaSettings.autocorrect ? strings.on : strings.off),
+            .groupFooter(-20, isRussian ? "Переводчик и автоисправление работают на устройстве и ничего не отправляют на сервер." : "Translator and autocorrect run on the device and send nothing to the server."),
+            .groupHeader(0, isRussian ? "ЧАТ" : "CHAT"),
+            .toggle(.editHistory, strings.editHistoryTitle, isRussian ? "Удержите изменённое сообщение → «История изменений»" : "Hold an edited message → Edit History", state.editHistory),
+            .toggle(.exactTime, strings.exactTimeTitle, isRussian ? "Секунды во времени сообщений" : "Seconds in message times", state.exactTime),
+            .toggle(.silent, strings.silentTitle, isRussian ? "Сообщения по умолчанию уходят без звука" : "Messages are sent silently by default", state.silentByDefault),
+            .toggle(.confirmCalls, isRussian ? "Подтверждать звонки" : "Confirm Calls", isRussian ? "Спросит перед звонком" : "Asks before placing a call", state.confirmCalls),
+            .toggle(.confirmStickers, isRussian ? "Подтверждать стикеры" : "Confirm Stickers", isRussian ? "Спросит перед отправкой стикера или GIF" : "Asks before sending a sticker or GIF", state.confirmStickers),
+            .toggle(.confirmVoice, isRussian ? "Прослушивать голосовые" : "Review Voice Messages", isRussian ? "Запись сначала откроется для прослушивания" : "A recording opens for review before it's sent", state.confirmVoice),
+            .groupHeader(10, isRussian ? "ПРОФИЛЬ" : "PROFILE"),
+            .toggle(.peerIds, strings.peerIdsTitle, isRussian ? "Дата-центр и дата регистрации, нажмите на ID, чтобы скопировать" : "Data center and registration date, tap the ID to copy", state.showPeerIds),
+            .toggle(.peerHistory, isRussian ? "История профилей" : "Profile History", isRussian ? "Прежние имена и юзернеймы собеседников" : "Previous names and usernames of people", state.peerHistory),
+            .toggle(.hidePhone, strings.hidePhoneTitle, isRussian ? "Номер не виден в настройках и профиле" : "Your number is hidden in settings and profile", state.hidePhone),
+            .groupHeader(20, strings.appearanceHeader),
+            .frames(strings.framesTitle, NyxaAppearanceSettings.avatarFrame.title(russian: isRussian)),
+            .banner(strings.bannerTitle, NyxaAppearanceSettings.bannerURL != nil ? strings.on : strings.off),
+            .toggle(.hideStories, isRussian ? "Скрыть истории" : "Hide Stories", isRussian ? "Убирает ленту историй над чатами" : "Removes the stories bar above chats", state.hideStories),
+            .toggle(.hideChatPreviews, isRussian ? "Скрыть текст в списке чатов" : "Hide Chat Previews", isRussian ? "В списке чатов не виден текст сообщений" : "The chat list doesn't show message text", state.hideChatPreviews),
+            .groupFooter(25, strings.appearanceFooter),
+            .groupHeader(30, isRussian ? "БЭКАП" : "BACKUP"),
+            .backupExport(isRussian ? "Сохранить настройки" : "Export Settings"),
+            .backupImport(isRussian ? "Восстановить из файла" : "Restore from File"),
+            .groupFooter(33, isRussian ? "Все настройки Nyxagram сохраняются в один файл, удобно перед переустановкой. Баннер в бэкап не входит, его нужно выбрать заново." : "All Nyxagram settings go into one file, handy before reinstalling. The profile banner isn't included and has to be picked again.")
+        ]
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(strings.title), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    pushImpl = { [weak controller] c in
+        controller?.push(c)
+    }
+    presentImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    navigationImpl = { [weak controller] in
+        return controller?.navigationController as? NavigationController
+    }
+    return controller
+}
