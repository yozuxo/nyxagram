+                let end = CGFloat(i + 1) / CGFloat(segments) * CGFloat.pi * 2.0 + 0.01
+                context.setStrokeColor(UIColor(hue: CGFloat(i) / CGFloat(segments), saturation: 0.85, brightness: 1.0, alpha: 1.0).cgColor)
