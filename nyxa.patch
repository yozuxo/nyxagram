+enum NyxaBannerError {
+    case wrongType
+    case tooLarge
+    case wrongAspect
+    case failed
+
+    func text(russian: Bool) -> String {
+        switch self {
+        case .wrongType:
+            return russian ? "Нужно видео (MOV или MP4) или GIF." : "Pick a video (MOV or MP4) or a GIF."
+        case .tooLarge:
+            return russian ? "Файл больше 50 МБ. Выберите файл поменьше." : "The file is larger than 50 MB. Pick a smaller one."
+        case .wrongAspect:
+            return russian ? "Нужен формат 16:9 (горизонтальное видео, например 1920×1080)." : "The banner must be 16:9 (a horizontal video, e.g. 1920×1080)."
+        case .failed:
+            return russian ? "Не удалось загрузить файл." : "Couldn't load the file."
+        }
+    }
+}
