+public enum NyxaPeerHistory {
+    private static let lock = NSLock()
+    private static var cache: [String: [NyxaPeerHistoryEntry]]?
+    private static let maxEntriesPerPeer = 20
+    
+    public static var enabled: Bool {
+        get { return UserDefaults.standard.object(forKey: "nyxa.peerHistory.enabled") as? Bool ?? true }
+        set { UserDefaults.standard.set(newValue, forKey: "nyxa.peerHistory.enabled") }
+    }
+    
+    private static func loadLocked() -> [String: [NyxaPeerHistoryEntry]] {
+        if let cache {
+            return cache
+        }
+        var result: [String: [NyxaPeerHistoryEntry]] = [:]
+        if let data = UserDefaults.standard.data(forKey: "nyxa.peerHistory"), let decoded = try? JSONDecoder().decode([String: [NyxaPeerHistoryEntry]].self, from: data) {
+            result = decoded
+        }
+        cache = result
+        return result
+    }
+    
+    public static func note(peerId: EnginePeer.Id, name: String, username: String?) {
+        if !enabled || name.isEmpty {
+            return
+        }
+        let key = "\(peerId.toInt64())"
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        var all = loadLocked()
+        var entries = all[key] ?? []
+        if let last = entries.last, last.name == name, last.username == username {
+            return
+        }
+        entries.append(NyxaPeerHistoryEntry(date: Int32(Date().timeIntervalSince1970), name: name, username: username))
+        if entries.count > maxEntriesPerPeer {
+            entries.removeFirst(entries.count - maxEntriesPerPeer)
+        }
+        all[key] = entries
+        cache = all
+        if let data = try? JSONEncoder().encode(all) {
+            UserDefaults.standard.set(data, forKey: "nyxa.peerHistory")
+        }
+    }
+    
+    public static func note(user: TelegramUser) {
+        if user.botInfo != nil {
+            return
+        }
+        let name = [user.firstName, user.lastName].compactMap { $0 }.filter { !$0.isEmpty }.joined(separator: " ")
+        note(peerId: user.id, name: name, username: user.addressName)
+    }
+    
+    public static func previous(peerId: EnginePeer.Id) -> [NyxaPeerHistoryEntry] {
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        let entries = loadLocked()["\(peerId.toInt64())"] ?? []
+        return Array(entries.dropLast().reversed())
+    }
+    
+    public static func removeAll() {
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        cache = [:]
+        UserDefaults.standard.removeObject(forKey: "nyxa.peerHistory")
+    }
+}
