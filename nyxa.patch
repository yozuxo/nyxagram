+++ b/submodules/TelegramUI/Components/PeerInfo/PeerInfoScreen/Sources/NyxaAppearance.swift
@@ -0,0 +1,547 @@
+import Foundation
+import UIKit
+import AVFoundation
+import ImageIO
+import PhotosUI
+import UniformTypeIdentifiers
+import Display
+import SwiftSignalKit
+import TelegramCore
+
+enum NyxaAppearanceSettings {
+    static let didChangeNotification = Notification.Name("NyxaAppearanceDidChange")
+
+    static var avatarFrame: NyxaAvatarFrameStyle {
+        get { return NyxaAvatarFrameStyle(rawValue: UserDefaults.standard.integer(forKey: "nyxa.avatarFrame")) ?? .none }
+        set {
+            UserDefaults.standard.set(newValue.rawValue, forKey: "nyxa.avatarFrame")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+
+    static var demoPremium: Bool {
+        get { return UserDefaults.standard.bool(forKey: "nyxa.demoPremium") }
+        set {
+            UserDefaults.standard.set(newValue, forKey: "nyxa.demoPremium")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+    
+    static var fakeLevelEnabled: Bool {
+        get { return UserDefaults.standard.bool(forKey: "nyxa.fakeLevelEnabled") }
+        set {
+            UserDefaults.standard.set(newValue, forKey: "nyxa.fakeLevelEnabled")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+    
+    static var fakeLevel: Int32 {
+        get {
+            let value = Int32(UserDefaults.standard.integer(forKey: "nyxa.fakeLevel"))
+            return value == 0 ? 10 : max(1, min(100, value))
+        }
+        set {
+            UserDefaults.standard.set(Int(max(1, min(100, newValue))), forKey: "nyxa.fakeLevel")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+    
+    static var directory: URL {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+        let url = base.appendingPathComponent("nyxa-appearance", isDirectory: true)
+        try? FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        return url
+    }
+
+    static var bannerURL: URL? {
+        guard let name = UserDefaults.standard.string(forKey: "nyxa.bannerFile") else {
+            return nil
+        }
+        let url = directory.appendingPathComponent(name)
+        return FileManager.default.fileExists(atPath: url.path) ? url : nil
+    }
+
+    static func setBanner(from source: URL?, fileExtension: String) {
+        if let current = bannerURL {
+            try? FileManager.default.removeItem(at: current)
+        }
+        if let source {
+            let name = "banner-\(Int(Date().timeIntervalSince1970)).\(fileExtension)"
+            let target = directory.appendingPathComponent(name)
+            if (try? FileManager.default.copyItem(at: source, to: target)) != nil {
+                UserDefaults.standard.set(name, forKey: "nyxa.bannerFile")
+            }
+        } else {
+            UserDefaults.standard.removeObject(forKey: "nyxa.bannerFile")
+        }
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+    }
+}
+
+enum NyxaAvatarFrameStyle: Int, CaseIterable {
+    case none = 0
+    case neon
+    case gold
+    case fire
+    case ice
+    case rainbow
+    case crown
+    case dashed
+    case nyxa
+
+    func title(russian: Bool) -> String {
+        switch self {
+        case .none:
+            return russian ? "Без рамки" : "No Frame"
+        case .neon:
+            return russian ? "Неон" : "Neon"
+        case .gold:
+            return russian ? "Золото" : "Gold"
+        case .fire:
+            return russian ? "Огонь" : "Fire"
+        case .ice:
+            return russian ? "Лёд" : "Ice"
+        case .rainbow:
+            return russian ? "Радуга" : "Rainbow"
+        case .crown:
+            return russian ? "Корона" : "Crown"
+        case .dashed:
+            return russian ? "Пунктир" : "Dashed"
+        case .nyxa:
+            return "Nyxagram"
+        }
+    }
+}
+
+private var nyxaFrameImageCache: [String: UIImage] = [:]
+
+let nyxaAvatarFrameOutset: CGFloat = 0.16
+
+func nyxaAvatarFrameImage(style: NyxaAvatarFrameStyle, avatarSize: CGFloat) -> UIImage? {
+    if style == .none || avatarSize <= 0.0 {
+        return nil
+    }
+    let key = "\(style.rawValue)-\(Int(avatarSize))"
+    if let cached = nyxaFrameImageCache[key] {
+        return cached
+    }
+    let side = avatarSize * (1.0 + nyxaAvatarFrameOutset * 2.0)
+    let size = CGSize(width: side, height: side)
+    let center = CGPoint(x: side / 2.0, y: side / 2.0)
+    let lineWidth = max(2.0, avatarSize * 0.045)
+    let radius = avatarSize / 2.0 + avatarSize * 0.035 + lineWidth / 2.0
+    let ring = UIBezierPath(arcCenter: center, radius: radius, startAngle: 0.0, endAngle: CGFloat.pi * 2.0, clockwise: true)
+
+    func gradientRing(_ context: CGContext, colors: [UIColor], vertical: Bool) {
+        context.saveGState()
+        context.addPath(ring.cgPath)
+        context.setLineWidth(lineWidth)
+        context.replacePathWithStrokedPath()
+        context.clip()
+        let space = CGColorSpaceCreateDeviceRGB()
+        if let gradient = CGGradient(colorsSpace: space, colors: colors.map { $0.cgColor } as CFArray, locations: nil) {
+            let start = vertical ? CGPoint(x: center.x, y: side) : CGPoint(x: 0.0, y: 0.0)
+            let end = vertical ? CGPoint(x: center.x, y: 0.0) : CGPoint(x: side, y: side)
+            context.drawLinearGradient(gradient, start: start, end: end, options: [])
+        }
+        context.restoreGState()
+    }
+
+    func glowRing(_ context: CGContext, color: UIColor, glow: UIColor, blur: CGFloat) {
+        context.setShadow(offset: .zero, blur: blur, color: glow.cgColor)
+        context.setStrokeColor(color.cgColor)
+        context.setLineWidth(lineWidth)
+        context.addPath(ring.cgPath)
+        context.strokePath()
+        context.setShadow(offset: .zero, blur: 0.0, color: nil)
+    }
+
+    func sparkle(_ context: CGContext, at point: CGPoint, size: CGFloat, color: UIColor) {
+        let path = UIBezierPath()
+        path.move(to: CGPoint(x: point.x, y: point.y - size))
+        path.addQuadCurve(to: CGPoint(x: point.x + size, y: point.y), controlPoint: point)
+        path.addQuadCurve(to: CGPoint(x: point.x, y: point.y + size), controlPoint: point)
+        path.addQuadCurve(to: CGPoint(x: point.x - size, y: point.y), controlPoint: point)
+        path.addQuadCurve(to: CGPoint(x: point.x, y: point.y - size), controlPoint: point)
+        context.setFillColor(color.cgColor)
+        context.addPath(path.cgPath)
+        context.fillPath()
+    }
+
+    let renderer = UIGraphicsImageRenderer(size: size)
+    let image = renderer.image { rendererContext in
+        let context = rendererContext.cgContext
+        switch style {
+        case .none:
+            break
+        case .neon:
+            let color = UIColor(red: 0.62, green: 0.45, blue: 1.0, alpha: 1.0)
