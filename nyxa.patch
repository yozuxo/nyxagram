+
+enum NyxaBackupResult {
+    case restored(Int)
+    case notABackup
+    case unreadable
+}
+
+final class NyxaBackupPicker: NSObject, UIDocumentPickerDelegate {
+    private let completion: (NyxaBackupResult) -> Void
+    private var keepAlive: NyxaBackupPicker?
+
+    private init(completion: @escaping (NyxaBackupResult) -> Void) {
+        self.completion = completion
+        super.init()
+    }
+
+    static func share(from viewController: UIViewController?) {
+        guard let viewController, let data = NyxaBackup.export() else {
+            return
+        }
+        let formatter = DateFormatter()
+        formatter.dateFormat = "yyyy-MM-dd"
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent("Nyxagram \(formatter.string(from: Date())).plist")
+        do {
+            try data.write(to: url, options: .atomic)
+        } catch {
+            return
+        }
+        let activityController = UIActivityViewController(activityItems: [url], applicationActivities: nil)
+        activityController.popoverPresentationController?.sourceView = viewController.view
+        activityController.popoverPresentationController?.sourceRect = CGRect(x: viewController.view.bounds.midX, y: viewController.view.bounds.midY, width: 1.0, height: 1.0)
+        viewController.present(activityController, animated: true)
+    }
+
+    static func restore(from viewController: UIViewController?, completion: @escaping (NyxaBackupResult) -> Void) {
+        guard let viewController else {
+            return
+        }
+        let holder = NyxaBackupPicker(completion: completion)
+        holder.keepAlive = holder
+        let picker = UIDocumentPickerViewController(forOpeningContentTypes: [.propertyList, .data], asCopy: true)
+        picker.delegate = holder
+        viewController.present(picker, animated: true)
+    }
+
+    private func finish(_ result: NyxaBackupResult) {
+        Queue.mainQueue().async {
+            self.completion(result)
+            self.keepAlive = nil
+        }
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        guard let url = urls.first, let data = try? Data(contentsOf: url) else {
+            self.finish(.unreadable)
+            return
+        }
+        if let count = NyxaBackup.restore(from: data) {
+            self.finish(.restored(count))
+        } else {
+            self.finish(.notABackup)
+        }
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        self.keepAlive = nil
+    }
+}
