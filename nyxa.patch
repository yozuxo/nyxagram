+    let currentPromise = ValuePromise<String?>(NyxaSettings.deviceModelOverride, ignoreRepeated: true)
+    var presentImpl: ((ViewController) -> Void)?
+
+    let apply: (String?) -> Void = { value in
+        let previous = NyxaSettings.deviceModelOverride
+        NyxaSettings.deviceModelOverride = value
+        currentPromise.set(value)
+        NotificationCenter.default.post(name: NyxaAppearanceSettings.didChangeNotification, object: nil)
+        if previous != value {
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            presentImpl?(textAlertController(context: context, title: nil, text: isRussian ? "Новое название устройства появится в сеансах после перезапуска Nyxagram. Закройте приложение (смахните вверх) и откройте снова." : "The new device name shows up in sessions after Nyxagram restarts. Swipe the app away and open it again.", actions: [
+                TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})
+            ]))
+        }
+    }
+
+    let arguments = NyxaDeviceArguments(select: apply, custom: {
+        let prompt = promptController(context: context, text: isRussian ? "Название устройства" : "Device Name", value: NyxaSettings.deviceModelOverride ?? "", placeholder: "iPhone 17 Pro Max", characterLimit: 64, apply: { value in
+            let name = (value ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
