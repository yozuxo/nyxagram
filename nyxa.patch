+            context.setStrokeColor(UIColor(white: 1.0, alpha: 0.85).cgColor)
+            context.setLineWidth(lineWidth * 0.3)
+            context.addPath(ring.cgPath)
+            context.strokePath()
+        case .gold:
+            gradientRing(context, colors: [UIColor(red: 0.72, green: 0.52, blue: 0.16, alpha: 1.0), UIColor(red: 1.0, green: 0.88, blue: 0.48, alpha: 1.0), UIColor(red: 0.8, green: 0.6, blue: 0.2, alpha: 1.0), UIColor(red: 1.0, green: 0.93, blue: 0.62, alpha: 1.0)], vertical: false)
+            let sparkleColor = UIColor(red: 1.0, green: 0.95, blue: 0.7, alpha: 1.0)
+            for angle in [CGFloat.pi * 1.25, CGFloat.pi * 1.85, CGFloat.pi * 0.35] {
