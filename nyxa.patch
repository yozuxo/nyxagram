diff --git a/submodules/TelegramUI/Sources/NyxaAutocorrect.swift b/submodules/TelegramUI/Sources/NyxaAutocorrect.swift
new file mode 100644
index 00000000..59f3b996
--- /dev/null
+++ b/submodules/TelegramUI/Sources/NyxaAutocorrect.swift
@@ -0,0 +1,465 @@
+import Foundation
+import UIKit
+import Postbox
+import TelegramCore
+
+enum NyxaAutocorrect {
+    private enum Script {
+        case cyrillic
+        case latin
+        case other
+    }
+
+    private struct Edit {
+        let range: NSRange
+        let replacement: String
+    }
+
+    private static let technicalRegex = try! NSRegularExpression(pattern: #"[^\s]*(?:https?://|www\.|[@#/\\_]|[\p{L}\p{N}]\.[\p{L}\p{N}]|[\p{L}\p{N}]:[\p{L}\p{N}]|\p{N})[^\s]*|`[^`]*`"#, options: [])
+    private static let wordRegex = try! NSRegularExpression(pattern: #"\p{L}+(?:['’]\p{L}+)?"#, options: [])
+    private static let doubleSpaceRegex = try! NSRegularExpression(pattern: #"(?<=\S)[ \t]{2,}(?=\S)"#, options: [])
+    private static let spaceBeforePunctuationRegex = try! NSRegularExpression(pattern: #"(?<=[\p{L}\p{N}])[ \t]+(?=[,;!?](?:\s|$))"#, options: [])
+    private static let missingSpaceAfterCommaRegex = try! NSRegularExpression(pattern: #"(?<=\p{L})[,;](?=\p{L})"#, options: [])
+    private static let missingSpaceAfterMarkRegex = try! NSRegularExpression(pattern: #"(?<=\p{L})[!?](?=\p{L})"#, options: [])
+    private static let sentenceStartRegex = try! NSRegularExpression(pattern: #"(?:\A|(?<=[.!?…][ \t]))(\p{Ll})"#, options: [])
+
+    private static let wordsAfterWhichComesThat: Set<String> = [
+        "знаю", "думаю", "считаю", "говорю", "сказал", "сказала", "сказали", "говорил", "говорила", "понял", "поняла",
+        "понимаю", "уверен", "уверена", "кажется", "слышал", "слышала", "вижу", "видел", "видела", "помню", "надеюсь",
+        "боюсь", "полагаю", "верю", "жаль", "рад", "рада", "хорошо", "оказалось", "выяснилось"
+    ]
+    private static let commaBeforeUnlessAfter: [String: Set<String>] = [
+        "а": ["и", "а", "но", "да"],
+        "но": ["не", "и", "а", "да"],
+        "однако": ["и", "а", "но"],
+        "зато": ["и", "а", "но"],
+        "хотя": ["и", "а", "но", "даже"],
+        "чтобы": ["и", "а", "но", "не", "ни", "только", "даже", "лишь"],
+        "если": ["и", "а", "но", "только", "даже", "как", "ли", "особенно", "разве", "тем"],
+        "поэтому": ["и", "а", "но", "не", "именно", "только", "как", "вот"]
+    ]
+    private static let notBeforeBecause: Set<String> = ["и", "а", "но", "не", "именно", "только", "просто", "вот", "как", "раз"]
+    private static let prepositions: Set<String> = [
+        "в", "во", "на", "с", "со", "о", "об", "обо", "из", "от", "до", "для", "у", "по", "к", "ко", "за", "над", "под",
+        "при", "про", "через", "между", "без", "перед", "около"
+    ]
+    private static let introductoryWords: Set<String> = [
+        "привет", "здравствуй", "здравствуйте", "короче", "кстати", "например", "конечно", "наверное", "возможно",
+        "впрочем", "итак", "ладно"
+    ]
+    private static let notAfterIntroductoryWord: Set<String> = ["ли", "бы", "же", "говоря"]
+    private static let englishContractions: [String: String] = [
+        "i": "I", "i'm": "I'm", "i'll": "I'll", "i've": "I've", "i'd": "I'd", "im": "I'm", "ive": "I've",
+        "dont": "don't", "cant": "can't", "wont": "won't", "didnt": "didn't", "doesnt": "doesn't", "isnt": "isn't",
+        "arent": "aren't", "wasnt": "wasn't", "werent": "weren't", "couldnt": "couldn't", "wouldnt": "wouldn't",
+        "shouldnt": "shouldn't", "havent": "haven't", "hasnt": "hasn't", "hadnt": "hadn't", "youre": "you're",
+        "theyre": "they're", "thats": "that's", "whats": "what's"
+    ]
+
+    static func corrected(_ message: EnqueueMessage) -> EnqueueMessage {
+        guard NyxaSettings.autocorrect else {
+            return message
+        }
+        guard case let .message(text, attributes, inlineStickers, mediaReference, threadId, replyToMessageId, replyToStoryId, localGroupingKey, correlationId, bubbleUpEmojiOrStickersets) = message, mediaReference == nil else {
+            return message
+        }
+        if attributes.contains(where: { $0 is RichTextMessageAttribute }) {
+            return message
+        }
+        var entities: [MessageTextEntity] = []
+        for attribute in attributes {
+            if let attribute = attribute as? TextEntitiesMessageAttribute {
+                entities = attribute.entities
+            }
+        }
+        guard let result = correct(text: text, entities: entities) else {
+            return message
+        }
+        let updatedAttributes = attributes.map { attribute -> MessageAttribute in
+            if attribute is TextEntitiesMessageAttribute {
+                return TextEntitiesMessageAttribute(entities: result.entities)
+            }
+            return attribute
+        }
+        return .message(text: result.text, attributes: updatedAttributes, inlineStickers: inlineStickers, mediaReference: mediaReference, threadId: threadId, replyToMessageId: replyToMessageId, replyToStoryId: replyToStoryId, localGroupingKey: localGroupingKey, correlationId: correlationId, bubbleUpEmojiOrStickersets: bubbleUpEmojiOrStickersets)
+    }
+
+    static func correct(text original: String, entities originalEntities: [MessageTextEntity]) -> (text: String, entities: [MessageTextEntity])? {
+        let trimmed = original.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.count < 3 || trimmed.count > 2000 || trimmed.hasPrefix("/") {
+            return nil
+        }
+        let script = dominantScript(original)
+        if script == .other {
+            return nil
+        }
+        var text = original
+        var entities = originalEntities
+
+        apply(spelling(text: text, entities: entities, script: script), text: &text, entities: &entities)
+        apply(spacing(text: text, entities: entities), text: &text, entities: &entities)
+        apply(capitals(text: text, entities: entities), text: &text, entities: &entities)
+        switch script {
+        case .cyrillic:
+            apply(russianCommas(text: text, entities: entities), text: &text, entities: &entities)
+        case .latin:
+            apply(english(text: text, entities: entities), text: &text, entities: &entities)
+        case .other:
+            break
+        }
+        if text == original {
+            return nil
+        }
+        return (text, entities)
+    }
+    
+    private static func spelling(text: String, entities: [MessageTextEntity], script: Script) -> [Edit] {
+        let language = script == .cyrillic ? "ru_RU" : "en_US"
+        guard UITextChecker.availableLanguages.contains(language) else {
+            return []
+        }
+        let checker = UITextChecker()
+        let ns = text as NSString
+        let protected = protectedRanges(text: text, entities: entities)
+        var edits: [Edit] = []
+        wordRegex.enumerateMatches(in: text, options: [], range: NSRange(location: 0, length: ns.length)) { match, _, _ in
+            guard let range = match?.range, range.length >= 5, !isProtected(range, in: protected) else {
+                return
+            }
+            let word = ns.substring(with: range)
+            guard scriptOf(word) == script else {
+                return
+            }
+            if range.location > 0 && ns.character(at: range.location - 1) == 0x2D {
+                return
+            }
+            let end = range.location + range.length
+            if end < ns.length && ns.character(at: end) == 0x2D {
+                return
+            }
+            let lower = word.lowercased()
+            let isCapitalised = word != lower
+            if isCapitalised {
+                if word != capitalisedFirst(lower) || !isSentenceStart(ns, location: range.location) {
+                    return
+                }
+            }
+            let misspelled = checker.rangeOfMisspelledWord(in: text, range: range, startingAt: range.location, wrap: false, language: language)
+            guard misspelled.location != NSNotFound, misspelled == range else {
+                return
+            }
+            guard let guess = checker.guesses(forWordRange: range, in: text, language: language)?.first else {
+                return
+            }
+            let fixed = guess.lowercased()
+            guard fixed != lower, !fixed.contains(" "), fixed.first == lower.first, abs(fixed.count - lower.count) <= 1 else {
+                return
+            }
+            let distance = editDistance(fixed, lower)
+            guard distance == 1 || (distance == 2 && fixed.count == lower.count) else {
+                return
+            }
+            edits.append(Edit(range: range, replacement: isCapitalised ? capitalisedFirst(fixed) : fixed))
+        }
+        return edits
+    }
+
+    private static func spacing(text: String, entities: [MessageTextEntity]) -> [Edit] {
+        let ns = text as NSString
+        let full = NSRange(location: 0, length: ns.length)
+        let protected = protectedRanges(text: text, entities: entities)
+        var edits: [Edit] = []
+
+        doubleSpaceRegex.enumerateMatches(in: text, options: [], range: full) { match, _, _ in
+            if let range = match?.range, !isProtected(range, in: protected) {
+                edits.append(Edit(range: range, replacement: " "))
+            }
+        }
+        spaceBeforePunctuationRegex.enumerateMatches(in: text, options: [], range: full) { match, _, _ in
+            if let range = match?.range, !isProtected(range, in: protected) {
+                edits.append(Edit(range: range, replacement: ""))
+            }
+        }
+        for regex in [missingSpaceAfterCommaRegex, missingSpaceAfterMarkRegex] {
+            regex.enumerateMatches(in: text, options: [], range: full) { match, _, _ in
+                if let range = match?.range {
+                    let insertion = NSRange(location: range.location + 1, length: 0)
+                    if !isProtected(range, in: protected) && !isProtected(insertion, in: protected) {
+                        edits.append(Edit(range: insertion, replacement: " "))
+                    }
+                }
+            }
+        }
+        return edits
+    }
+
+    private static func capitals(text: String, entities: [MessageTextEntity]) -> [Edit] {
+        let ns = text as NSString
+        let protected = protectedRanges(text: text, entities: entities)
+        let wordCount = text.split(whereSeparator: { $0.isWhitespace }).count
+        var edits: [Edit] = []
+        sentenceStartRegex.enumerateMatches(in: text, options: [], range: NSRange(location: 0, length: ns.length)) { match, _, _ in
+            guard let letter = match?.range(at: 1), letter.location != NSNotFound, !isProtected(letter, in: protected) else {
+                return
+            }
+            if letter.location == 0 {
+                if wordCount < 4 {
+                    return
+                }
+            } else {
+                let mark = ns.character(at: letter.location - 2)
+                if mark == 0x2026 || (mark == 0x2E && letter.location >= 3 && ns.character(at: letter.location - 3) == 0x2E) {
+                    return
+                }
+                if isProtected(NSRange(location: letter.location - 2, length: 1), in: protected) {
+                    return
+                }
+            }
+            edits.append(Edit(range: letter, replacement: ns.substring(with: letter).uppercased()))
+        }
+        return edits
+    }
+
+    private static func english(text: String, entities: [MessageTextEntity]) -> [Edit] {
+        let ns = text as NSString
+        let protected = protectedRanges(text: text, entities: entities)
+        var edits: [Edit] = []
+        wordRegex.enumerateMatches(in: text, options: [], range: NSRange(location: 0, length: ns.length)) { match, _, _ in
+            guard let range = match?.range, !isProtected(range, in: protected) else {
+                return
+            }
+            let word = ns.substring(with: range)
+            guard let fixed = englishContractions[word.lowercased()] else {
+                return
+            }
+            var replacement = fixed
+            if !fixed.hasPrefix("I"), let first = word.first, first.isUppercase {
+                replacement = capitalisedFirst(fixed)
+            }
+            if replacement != word {
+                edits.append(Edit(range: range, replacement: replacement))
+            }
+        }
+        return edits
+    }
+
+    private static func russianCommas(text: String, entities: [MessageTextEntity]) -> [Edit] {
+        let ns = text as NSString
+        let protected = protectedRanges(text: text, entities: entities)
+        var words: [(range: NSRange, lower: String)] = []
+        wordRegex.enumerateMatches(in: text, options: [], range: NSRange(location: 0, length: ns.length)) { match, _, _ in
+            if let range = match?.range {
+                words.append((range, ns.substring(with: range).lowercased()))
+            }
+        }
+        guard words.count >= 2 else {
+            return []
+        }
+
+        func onlySpacesBetween(_ first: Int, _ second: Int) -> Bool {
+            let start = words[first].range.location + words[first].range.length
+            let end = words[second].range.location
+            if end <= start {
+                return false
+            }
+            return ns.substring(with: NSRange(location: start, length: end - start)).allSatisfy { $0 == " " || $0 == "\t" }
+        }
+        var edits: [Edit] = []
+        var commaPositions = Set<Int>()
+        func comma(afterWordAt index: Int) {
+            let word = words[index].range
+            let insertion = NSRange(location: word.location + word.length, length: 0)
+            if commaPositions.contains(insertion.location) || isProtected(word, in: protected) || isProtected(insertion, in: protected) {
+                return
+            }
+            commaPositions.insert(insertion.location)
+            edits.append(Edit(range: insertion, replacement: ","))
+        }
+
+        for index in 1 ..< words.count {
+            let word = words[index].lower
+            let previous = words[index - 1].lower
+            if !onlySpacesBetween(index - 1, index) || isProtected(words[index].range, in: protected) {
+                continue
+            }
+            if word == "потому" {
+                if index + 1 < words.count, words[index + 1].lower == "что", !notBeforeBecause.contains(previous) {
+                    comma(afterWordAt: index - 1)
+                }
+            } else if word == "что" {
+                if wordsAfterWhichComesThat.contains(previous) {
+                    comma(afterWordAt: index - 1)
+                }
+            } else if word.hasPrefix("котор"), isFormOfWhich(word) {
+                if prepositions.contains(previous) {
+                    if index >= 2 && onlySpacesBetween(index - 2, index - 1) {
+                        comma(afterWordAt: index - 2)
+                    }
+                } else {
+                    comma(afterWordAt: index - 1)
+                }
+            } else if let excluded = commaBeforeUnlessAfter[word], !excluded.contains(previous) {
+                if word == "хотя", index + 1 < words.count, words[index + 1].lower == "бы" {
+                    continue
+                }
+                comma(afterWordAt: index - 1)
+            }
+        }
+
+        for index in 0 ..< words.count - 1 {
+            let word = words[index]
+            if introductoryWords.contains(word.lower), isSentenceStart(ns, location: word.range.location), onlySpacesBetween(index, index + 1), !notAfterIntroductoryWord.contains(words[index + 1].lower), !isProtected(word.range, in: protected) {
+                comma(afterWordAt: index)
+            }
+        }
+        return edits
+    }
+
+
+    private static func isFormOfWhich(_ word: String) -> Bool {
+        return ["который", "которая", "которое", "которые", "которого", "которому", "которым", "которой", "которую", "которых", "которыми", "котором"].contains(word)
+    }
+
+    private static func dominantScript(_ text: String) -> Script {
+        var cyrillic = 0
+        var latin = 0
+        for scalar in text.unicodeScalars {
+            switch scalar.value {
+            case 0x0400 ... 0x04FF:
+                cyrillic += 1
+            case 0x41 ... 0x5A, 0x61 ... 0x7A:
+                latin += 1
+            default:
+                break
+            }
+        }
+        if cyrillic == 0 && latin == 0 {
+            return .other
+        }
+        return cyrillic >= latin ? .cyrillic : .latin
+    }
+
+    private static func scriptOf(_ word: String) -> Script {
+        guard let scalar = word.unicodeScalars.first else {
+            return .other
+        }
+        switch scalar.value {
+        case 0x0400 ... 0x04FF:
+            return .cyrillic
+        case 0x41 ... 0x5A, 0x61 ... 0x7A:
+            return .latin
+        default:
+            return .other
+        }
+    }
+
+    private static func capitalisedFirst(_ word: String) -> String {
+        return word.prefix(1).uppercased() + word.dropFirst()
+    }
+
+    private static func isSentenceStart(_ ns: NSString, location: Int) -> Bool {
+        var index = location - 1
+        while index >= 0 {
+            let character = ns.character(at: index)
+            if character == 0x20 || character == 0x09 {
+                index -= 1
+                continue
+            }
+            return character == 0x2E || character == 0x21 || character == 0x3F || character == 0x2026 || character == 0x0A
+        }
+        return true
+    }
+
+    private static func editDistance(_ lhs: String, _ rhs: String) -> Int {
+        let a = Array(lhs)
+        let b = Array(rhs)
+        if a.isEmpty {
+            return b.count
+        }
+        if b.isEmpty {
+            return a.count
+        }
+        var previous = Array(0 ... b.count)
+        for i in 1 ... a.count {
+            var current = [i] + Array(repeating: 0, count: b.count)
+            for j in 1 ... b.count {
+                let cost = a[i - 1] == b[j - 1] ? 0 : 1
+                current[j] = min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
+            }
+            previous = current
+        }
+        return previous[b.count]
+    }
+
+    private static func protectedRanges(text: String, entities: [MessageTextEntity]) -> [NSRange] {
+        var ranges: [NSRange] = []
+        for entity in entities {
+            switch entity.type {
+            case .Bold, .Italic, .Strikethrough, .Underline, .Spoiler, .BlockQuote:
+                break
+            default:
+                ranges.append(NSRange(location: entity.range.lowerBound, length: entity.range.count))
+            }
+        }
+        technicalRegex.enumerateMatches(in: text, options: [], range: NSRange(location: 0, length: (text as NSString).length)) { match, _, _ in
+            if let range = match?.range {
+                ranges.append(range)
+            }
+        }
+        return ranges
+    }
+
+    private static func isProtected(_ range: NSRange, in protected: [NSRange]) -> Bool {
+        for item in protected {
+            if range.length == 0 {
+                if range.location > item.location && range.location < item.location + item.length {
+                    return true
+                }
+            } else if NSIntersectionRange(range, item).length > 0 {
+                return true
+            }
+        }
+        return false
+    }
+
+    private static func apply(_ edits: [Edit], text: inout String, entities: inout [MessageTextEntity]) {
+        if edits.isEmpty {
+            return
+        }
+        var lastLocation = Int.max
+        for edit in edits.sorted(by: { $0.range.location > $1.range.location }) {
+            let start = edit.range.location
+            let end = start + edit.range.length
+            let ns = text as NSString
+            if start < 0 || end > ns.length || end > lastLocation {
+                continue
+            }
+            var cutsAnEntity = false
+            for entity in entities {
+                let inside = start >= entity.range.lowerBound && end <= entity.range.upperBound
+                let outside = end <= entity.range.lowerBound || start >= entity.range.upperBound
+                if !inside && !outside {
+                    cutsAnEntity = true
+                    break
+                }
+            }
+            if cutsAnEntity {
+                continue
+            }
+            text = ns.replacingCharacters(in: edit.range, with: edit.replacement)
+            let delta = (edit.replacement as NSString).length - edit.range.length
+            entities = entities.map { entity -> MessageTextEntity in
+                let lower = entity.range.lowerBound
+                let upper = entity.range.upperBound
+                if lower >= end {
+                    return MessageTextEntity(range: (lower + delta) ..< (upper + delta), type: entity.type)
+                } else if upper <= start {
+                    return entity
+                } else {
+                    return MessageTextEntity(range: lower ..< max(lower, upper + delta), type: entity.type)
+                }
+            }
+            lastLocation = start
+        }
+    }
+}
