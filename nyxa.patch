+- (void)nyxaSpawnDrop
+{
+    if (!_nyxaEffectsRunning || _nyxaRainView == nil) {
+        return;
+    }
+    CGSize bounds = _nyxaRainView.bounds.size;
+    if (bounds.width < 1.0f || bounds.height < 1.0f) {
+        return;
+    }
+    
+    CGFloat depth = nyxaRandom(0.0f, 1.0f);
+    CGFloat x = nyxaRandom(0.0f, bounds.width);
+    CGFloat landingY = bounds.height * (0.5f + 0.47f * depth);
+    CGFloat length = 12.0f + 18.0f * depth;
+    CGFloat speed = 950.0f + 650.0f * depth;
+    CFTimeInterval duration = (landingY + length + 20.0f) / speed;
+    
+    CAGradientLayer *drop = [CAGradientLayer layer];
+    drop.colors = @[(__bridge id)[UIColor colorWithWhite:1.0f alpha:0.0f].CGColor, (__bridge id)[UIColor colorWithWhite:1.0f alpha:0.35f + 0.45f * depth].CGColor];
+    drop.bounds = CGRectMake(0.0f, 0.0f, 1.0f + 1.0f * depth, length);
+    drop.cornerRadius = drop.bounds.size.width / 2.0f;
+    drop.anchorPoint = CGPointMake(0.5f, 1.0f);
+    drop.position = CGPointMake(x, landingY);
+    [_nyxaRainView.layer insertSublayer:drop below:_nyxaFlashView.layer];
+    
+    CABasicAnimation *fall = [CABasicAnimation animationWithKeyPath:@"position.y"];
+    fall.fromValue = @(-20.0f);
+    fall.toValue = @(landingY);
+    fall.duration = duration;
+    fall.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionLinear];
+    
+    __weak RMIntroViewController *weakSelf = self;
+    [CATransaction begin];
+    [CATransaction setCompletionBlock:^{
+        [drop removeFromSuperlayer];
+        __strong RMIntroViewController *strongSelf = weakSelf;
+        [strongSelf nyxaSplashAtPoint:CGPointMake(x, landingY) depth:depth];
+    }];
+    [drop addAnimation:fall forKey:@"fall"];
+    [CATransaction commit];
+}
+
+- (void)nyxaSplashAtPoint:(CGPoint)point depth:(CGFloat)depth
+{
+    if (!_nyxaEffectsRunning) {
+        return;
+    }
+    CGFloat width = 14.0f + 26.0f * depth;
+    CAShapeLayer *ring = [CAShapeLayer layer];
+    ring.frame = CGRectMake(point.x - width / 2.0f, point.y - width * 0.15f, width, width * 0.3f);
+    ring.path = [UIBezierPath bezierPathWithOvalInRect:ring.bounds].CGPath;
+    ring.fillColor = [UIColor clearColor].CGColor;
+    ring.strokeColor = [UIColor colorWithWhite:1.0f alpha:0.3f + 0.4f * depth].CGColor;
+    ring.lineWidth = 0.8f + 0.6f * depth;
+    ring.opacity = 0.0f;
+    [_nyxaRainView.layer insertSublayer:ring below:_nyxaFlashView.layer];
+    
+    CABasicAnimation *ringScale = [CABasicAnimation animationWithKeyPath:@"transform.scale"];
+    ringScale.fromValue = @0.15;
+    ringScale.toValue = @1.0;
+    CABasicAnimation *ringOpacity = [CABasicAnimation animationWithKeyPath:@"opacity"];
+    ringOpacity.fromValue = @1.0;
+    ringOpacity.toValue = @0.0;
+    CAAnimationGroup *ringGroup = [CAAnimationGroup animation];
+    ringGroup.animations = @[ringScale, ringOpacity];
+    ringGroup.duration = 0.5;
+    ringGroup.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+    
+    NSMutableArray<CALayer *> *layers = [[NSMutableArray alloc] initWithObjects:ring, nil];
+    
+    int droplets = depth > 0.4f ? 2 + (int)arc4random_uniform(2) : 1;
+    for (int i = 0; i < droplets; i++) {
+        CGFloat size = 1.5f + 1.5f * depth;
+        CALayer *droplet = [CALayer layer];
+        droplet.bounds = CGRectMake(0.0f, 0.0f, size, size);
+        droplet.cornerRadius = size / 2.0f;
+        droplet.backgroundColor = [UIColor colorWithWhite:1.0f alpha:0.4f + 0.4f * depth].CGColor;
+        droplet.position = point;
+        droplet.opacity = 0.0f;
+        [_nyxaRainView.layer insertSublayer:droplet below:_nyxaFlashView.layer];
+        [layers addObject:droplet];
+        
+        CGFloat dx = nyxaRandom(-1.0f, 1.0f) * (6.0f + 12.0f * depth);
+        CGFloat height = nyxaRandom(5.0f, 9.0f + 14.0f * depth);
+        UIBezierPath *path = [UIBezierPath bezierPath];
+        [path moveToPoint:point];
+        [path addQuadCurveToPoint:CGPointMake(point.x + dx, point.y + 2.0f) controlPoint:CGPointMake(point.x + dx * 0.5f, point.y - height * 2.0f)];
+        CAKeyframeAnimation *arc = [CAKeyframeAnimation animationWithKeyPath:@"position"];
+        arc.path = path.CGPath;
+        CAKeyframeAnimation *fade = [CAKeyframeAnimation animationWithKeyPath:@"opacity"];
+        fade.values = @[@1.0, @1.0, @0.0];
+        fade.keyTimes = @[@0.0, @0.6, @1.0];
+        CAAnimationGroup *dropletGroup = [CAAnimationGroup animation];
+        dropletGroup.animations = @[arc, fade];
+        dropletGroup.duration = 0.32 + 0.12 * depth;
+        [droplet addAnimation:dropletGroup forKey:@"bounce"];
+    }
+    
+    [CATransaction begin];
+    [CATransaction setCompletionBlock:^{
+        for (CALayer *layer in layers) {
+            [layer removeFromSuperlayer];
+        }
+    }];
+    [ring addAnimation:ringGroup forKey:@"splash"];
+    [CATransaction commit];
+    
+    if (_nyxaDropPlayers.count != 0 && nyxaRandom(0.0f, 1.0f) < 0.25f + 0.55f * depth) {
+        AVAudioPlayer *player = _nyxaDropPlayers[_nyxaDropPlayerIndex % _nyxaDropPlayers.count];
+        _nyxaDropPlayerIndex += 1;
+        [player stop];
+        player.currentTime = 0.0;
+        player.volume = (float)(0.08f + 0.5f * depth * depth);
+        player.rate = (float)nyxaRandom(0.8f, 1.3f);
+        player.pan = (float)((point.x / MAX(1.0f, _nyxaRainView.bounds.size.width)) * 1.4f - 0.7f);
+        [player play];
+    }
+}
