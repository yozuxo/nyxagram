+func nyxaPremiumBadgeImage() -> UIImage? {
+    if let cached = nyxaPremiumBadgeCache {
+        return cached
+    }
+    let size = CGSize(width: 24.0, height: 24.0)
+    let image = UIGraphicsImageRenderer(size: size).image { context in
+        let rect = CGRect(origin: CGPoint(), size: size).insetBy(dx: 1.0, dy: 1.0)
+        context.cgContext.addEllipse(in: rect)
+        context.cgContext.clip()
+        let colors = [UIColor(red: 0.76, green: 0.42, blue: 1.0, alpha: 1.0).cgColor, UIColor(red: 0.42, green: 0.12, blue: 0.86, alpha: 1.0).cgColor] as CFArray
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0.0, 1.0]) {
+            context.cgContext.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: 0.0), end: CGPoint(x: size.width, y: size.height), options: [])
+        }
+        if let logo = UIImage(named: "NyxaIntroLogo"), logo.size.height > 0.0 {
+            let height: CGFloat = 13.0
+            let width = height * logo.size.width / logo.size.height
+            logo.draw(in: CGRect(x: (size.width - width) / 2.0, y: (size.height - height) / 2.0, width: width, height: height))
+        }
+    }
+    nyxaPremiumBadgeCache = image
+    return image
+}
