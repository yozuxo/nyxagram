+public enum NyxaUsers {
+    public static let marker = "\u{2063}\u{2064}\u{2063}"
+    
+    private static let lock = NSLock()
+    
+    public static func isKnown(peerId: EnginePeer.Id) -> Bool {
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        let known = UserDefaults.standard.array(forKey: "nyxa.knownUsers") as? [NSNumber] ?? []
+        return known.contains(where: { $0.int64Value == peerId.toInt64() })
+    }
+    
+    public static func noteMessage(text: String, authorId: EnginePeer.Id?, accountPeerId: EnginePeer.Id) {
+        guard let authorId, authorId != accountPeerId, text.hasSuffix(marker) else {
+            return
+        }
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        var known = UserDefaults.standard.array(forKey: "nyxa.knownUsers") as? [NSNumber] ?? []
+        if !known.contains(where: { $0.int64Value == authorId.toInt64() }) {
+            known.append(NSNumber(value: authorId.toInt64()))
+            UserDefaults.standard.set(known, forKey: "nyxa.knownUsers")
+        }
+    }
+    
+    public static func stripMarker(_ text: String) -> String {
+        if text.hasSuffix(marker) {
