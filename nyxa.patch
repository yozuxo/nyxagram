+public func renderNyxaSettingsIcon(systemName: String, backgroundColors: [UIColor]) -> UIImage? {
+    return generateImage(CGSize(width: 30.0, height: 30.0), rotatedContext: { size, context in
+        let bounds = CGRect(origin: CGPoint(), size: size)
+        context.clear(bounds)
+        
+        context.saveGState()
+        context.addPath(UIBezierPath(roundedRect: bounds, cornerRadius: 8.0).cgPath)
+        context.clip()
+        var locations: [CGFloat] = [0.0, 1.0]
+        let colors: [CGColor] = (backgroundColors.count == 1 ? [backgroundColors[0], backgroundColors[0]] : backgroundColors).map(\.cgColor)
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors as CFArray, locations: &locations) {
+            context.drawLinearGradient(gradient, start: CGPoint(x: 0.0, y: 0.0), end: CGPoint(x: size.width, y: size.height), options: CGGradientDrawingOptions())
+        }
+        context.restoreGState()
+        
+        let configuration = UIImage.SymbolConfiguration(pointSize: 15.0, weight: .semibold)
+        if let symbol = UIImage(systemName: systemName, withConfiguration: configuration)?.withTintColor(.white, renderingMode: .alwaysOriginal) {
+            let symbolSize = symbol.size
+            UIGraphicsPushContext(context)
+            symbol.draw(in: CGRect(origin: CGPoint(x: floor((size.width - symbolSize.width) * 0.5), y: floor((size.height - symbolSize.height) * 0.5)), size: symbolSize))
+            UIGraphicsPopContext()
+        }
+    })
+}
