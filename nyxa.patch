+public func nyxaEstimatedRegistrationDate(userId: Int64) -> Int32? {
+    guard userId > 0, let first = nyxaRegistrationPoints.first, let last = nyxaRegistrationPoints.last else {
+        return nil
+    }
+    if userId <= first.0 {
+        return first.1
+    }
+    if userId >= last.0 {
+        return last.1
+    }
+    for i in 1 ..< nyxaRegistrationPoints.count {
+        let (upperId, upperDate) = nyxaRegistrationPoints[i]
+        if userId <= upperId {
+            let (lowerId, lowerDate) = nyxaRegistrationPoints[i - 1]
+            let fraction = Double(userId - lowerId) / Double(upperId - lowerId)
+            return lowerDate + Int32(Double(upperDate - lowerDate) * fraction)
+        }
+    }
+    return last.1
+}
