+    [_nyxaRainPlayer stop];
+    _nyxaRainPlayer = nil;
+    [_nyxaThunderPlayer stop];
+    _nyxaThunderPlayer = nil;
+    for (AVAudioPlayer *player in _nyxaDropPlayers) {
+        [player stop];
