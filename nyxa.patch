+private enum NyxaSwitchEntry: ItemListNodeEntry {
+    case toggle(String, Bool)
+    case footer(String)
+    case detailHeader(String)
+    case detail(Int32, NyxaSwitchDetail)
+    case detailFooter(String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .toggle, .footer:
+            return 0
+        case .detailHeader, .detail, .detailFooter:
+            return 1
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .toggle:
+            return 0
+        case .footer:
+            return 1
+        case .detailHeader:
+            return 10
+        case let .detail(index, _):
+            return 11 + index
+        case .detailFooter:
+            return 100
+        }
+    }
+
+    static func <(lhs: NyxaSwitchEntry, rhs: NyxaSwitchEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! NyxaSwitchArguments
+        switch self {
+        case let .toggle(title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, icon: arguments.icon, title: title, value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle(value)
+            })
+        case let .footer(text), let .detailFooter(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .detailHeader(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .detail(_, detail):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, icon: detail.icon, title: detail.title, label: detail.text, labelStyle: .multilineDetailText, sectionId: self.section, style: .blocks, disclosureStyle: .none, action: nil)
+        }
+    }
+}
