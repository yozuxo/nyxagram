+private final class NyxaNotificationObserver {
+    private var tokens: [NSObjectProtocol] = []
+    private var revision = 0
+
+    init(names: [Notification.Name], action: @escaping (Int) -> Void) {
+        self.tokens = names.map { name in
+            return NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main, using: { [weak self] _ in
+                guard let self else {
+                    return
+                }
+                self.revision += 1
+                action(self.revision)
+            })
+        }
+    }
+
+    deinit {
+        for token in self.tokens {
+            NotificationCenter.default.removeObserver(token)
+        }
+    }
+}
