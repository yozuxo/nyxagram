+- (void)nyxaRunIntroAnimation
+{
+    CALayer *logo = _nyxaLogoView.layer;
+    _nyxaLogoView.alpha = 1.0f;
+    
+    CAKeyframeAnimation *scale = [CAKeyframeAnimation animationWithKeyPath:@"transform.scale"];
+    scale.values = @[@0.15, @1.14, @0.95, @1.02, @1.0];
+    scale.keyTimes = @[@0.0, @0.45, @0.65, @0.82, @1.0];
+    CAKeyframeAnimation *rotation = [CAKeyframeAnimation animationWithKeyPath:@"transform.rotation.z"];
+    rotation.values = @[@(-0.6), @0.08, @(-0.03), @0.0];
+    rotation.keyTimes = @[@0.0, @0.45, @0.7, @1.0];
+    CABasicAnimation *opacity = [CABasicAnimation animationWithKeyPath:@"opacity"];
+    opacity.fromValue = @0.0;
+    opacity.toValue = @1.0;
+    opacity.duration = 0.45;
+    CAAnimationGroup *group = [CAAnimationGroup animation];
+    group.animations = @[scale, rotation, opacity];
+    group.duration = 1.2;
+    group.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+    [logo addAnimation:group forKey:@"nyxaIntro"];
+    
+    CABasicAnimation *glow = [CABasicAnimation animationWithKeyPath:@"shadowOpacity"];
+    glow.fromValue = @0.9;
+    glow.toValue = @0.35;
+    glow.beginTime = CACurrentMediaTime() + 0.55;
+    glow.duration = 1.4;
+    glow.fillMode = kCAFillModeBackwards;
+    logo.shadowOpacity = 0.35f;
+    [logo addAnimation:glow forKey:@"nyxaIntroGlow"];
+    
+    CGFloat radius = MAX(_nyxaLogoView.bounds.size.width, _nyxaLogoView.bounds.size.height) * 0.55f;
+    CAShapeLayer *ring = [CAShapeLayer layer];
+    ring.frame = CGRectMake(_nyxaLogoView.center.x - radius, _nyxaLogoView.center.y - radius, radius * 2.0f, radius * 2.0f);
+    ring.path = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(0.0f, 0.0f, radius * 2.0f, radius * 2.0f)].CGPath;
+    ring.fillColor = [UIColor clearColor].CGColor;
+    ring.strokeColor = [UIColor whiteColor].CGColor;
+    ring.lineWidth = 2.0f;
+    ring.opacity = 0.0f;
+    [self.view.layer insertSublayer:ring below:logo];
+    
+    CABasicAnimation *ringScale = [CABasicAnimation animationWithKeyPath:@"transform.scale"];
+    ringScale.fromValue = @0.5;
+    ringScale.toValue = @2.8;
+    CABasicAnimation *ringOpacity = [CABasicAnimation animationWithKeyPath:@"opacity"];
+    ringOpacity.fromValue = @0.9;
+    ringOpacity.toValue = @0.0;
+    CABasicAnimation *ringWidth = [CABasicAnimation animationWithKeyPath:@"lineWidth"];
+    ringWidth.fromValue = @4.0;
+    ringWidth.toValue = @0.5;
+    CAAnimationGroup *ringGroup = [CAAnimationGroup animation];
+    ringGroup.animations = @[ringScale, ringOpacity, ringWidth];
+    ringGroup.beginTime = CACurrentMediaTime() + 0.5;
+    ringGroup.duration = 1.1;
+    ringGroup.fillMode = kCAFillModeBackwards;
+    ringGroup.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+    [CATransaction begin];
+    [CATransaction setCompletionBlock:^{
+        [ring removeFromSuperlayer];
+    }];
+    [ring addAnimation:ringGroup forKey:@"nyxaRing"];
+    [CATransaction commit];
+}
