+public enum NyxaLocalPremium {
+    public static let didChangeNotification = Notification.Name("NyxaLocalPremiumDidChange")
+    private static let lock = NSLock()
+    private static var cachedEnabled = UserDefaults.standard.bool(forKey: "nyxa.localPremium")
+    private static var accountPeerIds = Set<Int64>()
+    
+    public static var enabled: Bool {
+        get {
+            lock.lock()
+            defer { lock.unlock() }
+            return cachedEnabled
+        }
+        set {
+            lock.lock()
+            cachedEnabled = newValue
+            lock.unlock()
+            UserDefaults.standard.set(newValue, forKey: "nyxa.localPremium")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
