+final class NyxaBannerPicker: NSObject, PHPickerViewControllerDelegate {
+    private let completion: (NyxaBannerError?) -> Void
+    private var keepAlive: NyxaBannerPicker?
+
+    private init(completion: @escaping (NyxaBannerError?) -> Void) {
+        self.completion = completion
+        super.init()
+    }
+
+    static func present(from viewController: UIViewController?, completion: @escaping (NyxaBannerError?) -> Void) {
+        guard let viewController else {
+            return
+        }
+        let holder = NyxaBannerPicker(completion: completion)
+        holder.keepAlive = holder
+        var configuration = PHPickerConfiguration()
+        configuration.filter = .any(of: [.videos, .images])
+        configuration.selectionLimit = 1
+        configuration.preferredAssetRepresentationMode = .current
+        let picker = PHPickerViewController(configuration: configuration)
+        picker.delegate = holder
+        viewController.present(picker, animated: true)
+    }
+
+    private func finish(_ error: NyxaBannerError?) {
+        Queue.mainQueue().async {
+            self.completion(error)
+            self.keepAlive = nil
+        }
+    }
+
+    func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+        picker.dismiss(animated: true)
+        guard let provider = results.first?.itemProvider else {
+            self.keepAlive = nil
+            return
+        }
+        let isGif = provider.hasItemConformingToTypeIdentifier(UTType.gif.identifier)
+        let typeIdentifier: String
+        if isGif {
+            typeIdentifier = UTType.gif.identifier
+        } else if provider.hasItemConformingToTypeIdentifier(UTType.movie.identifier) {
+            typeIdentifier = UTType.movie.identifier
+        } else {
+            self.finish(.wrongType)
+            return
+        }
+        provider.loadFileRepresentation(forTypeIdentifier: typeIdentifier) { [weak self] url, _ in
+            guard let self else {
+                return
+            }
+            guard let url else {
+                self.finish(.failed)
+                return
+            }
+            self.finish(nyxaApplyBanner(url: url, isGif: isGif))
+        }
+    }
+}
