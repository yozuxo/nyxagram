+    public static func register(accountPeerId: EnginePeer.Id) {
+        lock.lock()
+        accountPeerIds.insert(accountPeerId.toInt64())
+        lock.unlock()
+    }
+    
+    static func isActive(for peerId: EnginePeer.Id) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return cachedEnabled && accountPeerIds.contains(peerId.toInt64())
+    }
+    
+    static func isLocalOnly(_ user: TelegramUser) -> Bool {
+        return isActive(for: user.id) && !user.flags.contains(.isPremium)
+    }
+    
+    private struct LocalProfile: Codable {
+        var hasStatus = false
+        var status: PeerEmojiStatus?
+        var hasColors = false
+        var nameColor: Int32?
+        var nameCollectible: PeerCollectibleColor?
+        var backgroundEmojiId: Int64?
+        var profileColor: Int32?
+        var profileBackgroundEmojiId: Int64?
+    }
+    
+    private static func profileKey(_ peerId: EnginePeer.Id) -> String {
+        return "nyxa.localPremium.profile.\(peerId.toInt64())"
+    }
+    
+    private static func loadProfile(_ peerId: EnginePeer.Id) -> LocalProfile? {
+        guard let data = UserDefaults.standard.data(forKey: profileKey(peerId)) else {
+            return nil
+        }
+        return try? JSONDecoder().decode(LocalProfile.self, from: data)
+    }
+    
+    private static func updateProfile(_ peerId: EnginePeer.Id, _ update: (inout LocalProfile) -> Void) {
+        var profile = loadProfile(peerId) ?? LocalProfile()
+        update(&profile)
+        if let data = try? JSONEncoder().encode(profile) {
+            UserDefaults.standard.set(data, forKey: profileKey(peerId))
+        }
+    }
+    
+    static func saveStatus(peerId: EnginePeer.Id, status: PeerEmojiStatus?) {
+        updateProfile(peerId, { profile in
+            profile.hasStatus = true
+            profile.status = status
+        })
+    }
+    
+    static func saveColors(peerId: EnginePeer.Id, nameColor: PeerNameColor?, nameCollectible: PeerCollectibleColor?, backgroundEmojiId: Int64?, profileColor: PeerNameColor?, profileBackgroundEmojiId: Int64?) {
+        updateProfile(peerId, { profile in
+            profile.hasColors = true
+            profile.nameColor = nameColor?.rawValue
+            profile.nameCollectible = nameCollectible
+            profile.backgroundEmojiId = backgroundEmojiId
+            profile.profileColor = profileColor?.rawValue
+            profile.profileBackgroundEmojiId = profileBackgroundEmojiId
+        })
+    }
+    
+    static func applyingLocalProfile(to user: TelegramUser) -> TelegramUser {
+        guard isLocalOnly(user), let profile = loadProfile(user.id) else {
+            return user
+        }
+        var result = user
+        if profile.hasStatus {
+            result = result.withUpdatedEmojiStatus(profile.status)
+        }
+        if profile.hasColors {
+            if let collectible = profile.nameCollectible {
+                result = result.withUpdatedNameColor(.collectible(collectible))
+            } else if let nameColor = profile.nameColor {
+                result = result.withUpdatedNameColor(.preset(PeerNameColor(rawValue: nameColor)))
+            }
+            result = result.withUpdatedBackgroundEmojiId(profile.backgroundEmojiId)
+            result = result.withUpdatedProfileColor(profile.profileColor.flatMap({ PeerNameColor(rawValue: $0) }))
+            result = result.withUpdatedProfileBackgroundEmojiId(profile.profileBackgroundEmojiId)
+        }
+        return result
+    }
+}
