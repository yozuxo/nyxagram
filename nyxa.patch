+private func nyxaStreakPeersController(context: AccountContext) -> ViewController {
+    let isRussian = nyxaIsRussianLocale()
+    let selectedPromise = ValuePromise<Set<Int64>>(NyxaStreaks.selectedPeerIds, ignoreRepeated: true)
+    let arguments = NyxaStreakPeersArguments(toggle: { peerId in
+        var selected = NyxaStreaks.selectedPeerIds
+        selected.formSymmetricDifference([peerId.toInt64()])
+        NyxaStreaks.selectedPeerIds = selected
+        selectedPromise.set(selected)
+    })
+
+    let accountPeerId = context.account.peerId
+    let peers: Signal<[EnginePeer], NoError> = context.engine.messages.chatList(group: .root, count: 300)
+    |> map { chatList -> [EnginePeer] in
+        var result: [EnginePeer] = []
+        for item in chatList.items.reversed() {
+            if let peer = item.renderedPeer.peer, case let .user(user) = peer, user.botInfo == nil, user.id != accountPeerId, !user.id.isTelegramNotifications {
+                result.append(peer)
+            }
+        }
+        return result
+    }
+    |> take(1)
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        selectedPromise.get(),
+        peers
+    )
+    |> map { presentationData, selected, peers -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [NyxaStreakPeersEntry] = [.header(isRussian ? "С КЕМ ГОРИТ ОГОНЁК" : "WHO GETS A STREAK")]
+        for (index, peer) in peers.enumerated() {
+            entries.append(.peer(Int32(index), peer.id, peer.displayTitle(strings: presentationData.strings, displayOrder: presentationData.nameDisplayOrder), selected.contains(peer.id.toInt64())))
+        }
+        entries.append(.footer(isRussian ? "Если никого не отметить, огонёк будет у всех." : "If nobody is selected, everyone gets a streak."))
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(isRussian ? "Выбрать" : "Choose"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false)
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
