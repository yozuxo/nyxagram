+private func nyxaFramePreviewIcon(_ style: NyxaAvatarFrameStyle) -> UIImage? {
+    let size = CGSize(width: 30.0, height: 30.0)
+    let renderer = UIGraphicsImageRenderer(size: size)
+    return renderer.image { context in
+        let avatarSide: CGFloat = 30.0 / (1.0 + nyxaAvatarFrameOutset * 2.0)
+        let avatarRect = CGRect(x: (30.0 - avatarSide) / 2.0, y: (30.0 - avatarSide) / 2.0, width: avatarSide, height: avatarSide)
+        context.cgContext.setFillColor(UIColor(rgb: 0x8E8E93).cgColor)
+        context.cgContext.fillEllipse(in: avatarRect)
+        if let frame = nyxaAvatarFrameImage(style: style, avatarSize: 60.0) {
+            frame.draw(in: CGRect(origin: CGPoint(), size: size))
+        }
+    }
+}
