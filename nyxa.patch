+    private static func ownedGift(_ gift: StarGift, accountPeerId: EnginePeer.Id) -> StarGift {
+        guard case let .unique(gift) = gift else {
+            return gift
+        }
+        return .unique(StarGift.UniqueGift(
+            id: gift.id,
+            giftId: gift.giftId,
+            title: gift.title,
+            number: gift.number,
+            slug: gift.slug,
+            owner: .peerId(accountPeerId),
+            attributes: gift.attributes,
+            availability: gift.availability,
+            giftAddress: gift.giftAddress,
+            resellAmounts: nil,
+            resellForTonOnly: false,
+            releasedBy: gift.releasedBy,
+            valueAmount: gift.valueAmount,
+            valueCurrency: gift.valueCurrency,
+            valueUsdAmount: gift.valueUsdAmount,
+            flags: gift.flags,
+            themePeerId: nil,
+            peerColor: gift.peerColor ?? derivedPeerColor(gift),
+            hostPeerId: nil,
+            minOfferStars: nil,
+            craftChancePermille: gift.craftChancePermille
+        ))
+    }
+
+    private static func derivedPeerColor(_ gift: StarGift.UniqueGift) -> PeerCollectibleColor? {
+        var modelFileId: Int64?
+        var patternFileId: Int64?
+        var innerColor: Int32?
+        var outerColor: Int32?
+        for attribute in gift.attributes {
+            switch attribute {
+            case let .model(_, file, _, _):
+                modelFileId = file.fileId.id
+            case let .pattern(_, file, _):
+                patternFileId = file.fileId.id
+            case let .backdrop(_, _, inner, outer, _, _, _):
+                innerColor = inner
+                outerColor = outer
+            case .originalInfo:
+                break
+            }
+        }
+        guard let modelFileId, let patternFileId, let innerColor, let outerColor else {
+            return nil
+        }
+        let inner = UInt32(bitPattern: innerColor) & 0xffffff
+        let outer = UInt32(bitPattern: outerColor) & 0xffffff
+        return PeerCollectibleColor(collectibleId: gift.id, giftEmojiFileId: modelFileId, backgroundEmojiId: patternFileId, accentColor: outer, colors: [inner, outer], darkAccentColor: outer, darkColors: [inner, outer])
+    }
