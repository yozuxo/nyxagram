+private struct NyxaSettingsState: Equatable {
+    var keepDeletedOwn: Bool
+    var keepDeletedIncoming: Bool
+    var hideReadReceipts: Bool
+    var hideOnline: Bool
+    var hideTyping: Bool
+    var fakePhone: Bool
+    var editHistory: Bool
+    var exactTime: Bool
+    var hideStoryViews: Bool
+    var silentByDefault: Bool
+    var showPeerIds: Bool
+    var fakeUsernames: Bool
+    var hideListened: Bool
+    var hidePhone: Bool
+    var hideStories: Bool
+    var confirmCalls: Bool
+    var confirmStickers: Bool
+    var confirmVoice: Bool
+    var peerHistory: Bool
+    var hideChatPreviews: Bool
+
+    static func current() -> NyxaSettingsState {
+        return NyxaSettingsState(
+            keepDeletedOwn: NyxaSettings.keepDeletedOwnMessages,
+            keepDeletedIncoming: NyxaSettings.keepDeletedIncomingMessages,
+            hideReadReceipts: NyxaSettings.hideReadReceipts,
+            hideOnline: NyxaSettings.hideOnlineStatus,
+            hideTyping: NyxaSettings.hideTyping,
+            fakePhone: NyxaSettings.fakePhoneEnabled,
+            editHistory: NyxaSettings.keepEditHistory,
+            exactTime: NyxaSettings.exactTime,
+            hideStoryViews: NyxaSettings.hideStoryViews,
+            silentByDefault: NyxaSettings.silentByDefault,
+            showPeerIds: NyxaSettings.showPeerIds,
+            fakeUsernames: NyxaSettings.fakeUsernamesEnabled,
+            hideListened: NyxaSettings.hideListened,
+            hidePhone: NyxaSettings.hidePhone,
+            hideStories: NyxaSettings.hideStories,
+            confirmCalls: NyxaSettings.confirmCalls,
+            confirmStickers: NyxaSettings.confirmStickers,
+            confirmVoice: NyxaSettings.confirmVoice,
+            peerHistory: NyxaPeerHistory.enabled,
+            hideChatPreviews: NyxaSettings.hideChatPreviews
+        )
+    }
+
+    func apply() {
+        NyxaSettings.keepDeletedOwnMessages = self.keepDeletedOwn
+        NyxaSettings.keepDeletedIncomingMessages = self.keepDeletedIncoming
+        NyxaSettings.hideReadReceipts = self.hideReadReceipts
+        NyxaSettings.hideOnlineStatus = self.hideOnline
+        NyxaSettings.hideTyping = self.hideTyping
+        NyxaSettings.fakePhoneEnabled = self.fakePhone
+        NyxaSettings.keepEditHistory = self.editHistory
+        NyxaSettings.exactTime = self.exactTime
+        NyxaSettings.hideStoryViews = self.hideStoryViews
+        NyxaSettings.silentByDefault = self.silentByDefault
+        NyxaSettings.showPeerIds = self.showPeerIds
+        NyxaSettings.fakeUsernamesEnabled = self.fakeUsernames
+        NyxaSettings.hideListened = self.hideListened
+        NyxaSettings.hidePhone = self.hidePhone
+        if NyxaSettings.hideStories != self.hideStories {
+            NyxaSettings.hideStories = self.hideStories
+        }
+        NyxaSettings.confirmCalls = self.confirmCalls
+        NyxaSettings.confirmStickers = self.confirmStickers
+        NyxaSettings.confirmVoice = self.confirmVoice
+        NyxaPeerHistory.enabled = self.peerHistory
+        if NyxaSettings.hideChatPreviews != self.hideChatPreviews {
+            NyxaSettings.hideChatPreviews = self.hideChatPreviews
+        }
+    }
+
+    var deletedEnabledCount: Int {
+        return (self.keepDeletedOwn ? 1 : 0) + (self.keepDeletedIncoming ? 1 : 0)
+    }
+
+    var ghostEnabledCount: Int {
+        return (self.hideReadReceipts ? 1 : 0) + (self.hideOnline ? 1 : 0) + (self.hideTyping ? 1 : 0) + (self.hideStoryViews ? 1 : 0) + (self.hideListened ? 1 : 0)
+    }
+}
+
+private final class NyxaSettingsStore {
+    let statePromise = ValuePromise(NyxaSettingsState.current(), ignoreRepeated: true)
+
+    func update(_ f: (inout NyxaSettingsState) -> Void) {
+        var state = NyxaSettingsState.current()
+        f(&state)
+        state.apply()
+        self.statePromise.set(state)
+    }
+}
