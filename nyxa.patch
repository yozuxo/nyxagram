+        switch reference {
+        case let .peer(_, id):
+            return id < 0
+        case let .message(messageId):
+            return messageId.namespace == Namespaces.Message.Local
+        case .slug:
+            return false
+        }
+    }
+    
+    static func entry(for reference: StarGiftReference, accountPeerId: EnginePeer.Id) -> NyxaFakeGiftEntry? {
+        switch reference {
+        case let .peer(_, id):
+            return entries(accountPeerId: accountPeerId).first(where: { $0.id == id })
+        case let .message(messageId):
+            return entries(accountPeerId: accountPeerId).first(where: { $0.messageId == messageId.id })
+        case .slug:
+            return nil
+        }
