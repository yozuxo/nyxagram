diff --git a/submodules/AuthorizationUI/Sources/NyxaAuthLogoNode.swift b/submodules/AuthorizationUI/Sources/NyxaAuthLogoNode.swift
new file mode 100644
index 00000000..199114f4
--- /dev/null
+++ b/submodules/AuthorizationUI/Sources/NyxaAuthLogoNode.swift
@@ -0,0 +1,34 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+
+final class NyxaAuthLogoNode: ASImageNode {
+    private var didAnimateIn = false
+    
+    override init() {
+        super.init()
+        
+        self.displaysAsynchronously = false
+        self.isUserInteractionEnabled = false
+        self.image = UIImage(named: "NyxaIntroLogo")
+    }
+    
+    func update(replacing node: ASDisplayNode, transition: ContainedViewLayoutTransition) {
+        node.alpha = 0.0
+        self.isHidden = node.isHidden
+        guard let image = self.image, image.size.width > 0.0, image.size.height > 0.0 else {
+            return
+        }
+        let area = node.frame
+        let scale = min(area.width / image.size.width, area.height / image.size.height)
+        let size = CGSize(width: floor(image.size.width * scale), height: floor(image.size.height * scale))
+        transition.updateFrame(node: self, frame: CGRect(origin: CGPoint(x: floorToScreenPixels(area.midX - size.width / 2.0), y: floorToScreenPixels(area.midY - size.height / 2.0)), size: size))
+        
+        if !self.didAnimateIn && !self.isHidden && !area.isEmpty {
+            self.didAnimateIn = true
+            self.layer.animateSpring(from: 0.4 as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.6)
+            self.layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.25)
+        }
+    }
+}
