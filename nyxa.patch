+private func nyxaFakePhoneController(context: AccountContext, store: NyxaSettingsStore, strings: NyxaStrings) -> ViewController {
+    let isRussian = nyxaIsRussianLocale()
+    let accountPeerId = context.account.peerId
+    let numberPromise = ValuePromise<String?>(NyxaSettings.fakePhoneNumber(accountPeerId: accountPeerId), ignoreRepeated: true)
+    var switchRevision = 0
+    let switchRevisionPromise = ValuePromise<Int>(0, ignoreRepeated: true)
+
+    var presentImpl: ((ViewController) -> Void)?
+
+    let runChangeFlow: (@escaping () -> Void) -> Void = { completion in
+        let numberPrompt = promptController(context: context, text: strings.fakePhoneEnterNumber, value: NyxaSettings.fakePhoneNumber(accountPeerId: accountPeerId).flatMap { "+" + $0 } ?? "+", placeholder: "+7 900 000 00 00", characterLimit: 24, apply: { value in
+            let digits = (value ?? "").filter { $0.isNumber }
+            if digits.isEmpty {
+                return
+            }
+            let codePrompt = promptController(context: context, text: strings.fakePhoneEnterCode, subtitle: strings.fakePhoneCodeText, value: "", placeholder: "12345", characterLimit: 12, apply: { code in
+                guard let code, !code.isEmpty else {
+                    return
+                }
+                NyxaSettings.setFakePhoneNumber(digits, accountPeerId: accountPeerId)
+                numberPromise.set(digits)
+                completion()
+            })
+            Queue.mainQueue().after(0.3) {
+                presentImpl?(codePrompt)
+            }
+        })
+        presentImpl?(numberPrompt)
+    }
+
+    let arguments = NyxaFakePhoneArguments(toggle: { value in
+        if !value {
+            store.update { state in
+                state.fakePhone = false
+            }
+            return
+        }
+        switchRevision += 1
+        switchRevisionPromise.set(switchRevision)
+        let alert = textAlertController(context: context, title: strings.fakePhoneTitle, text: strings.fakePhoneAlertText, actions: [
+            TextAlertAction(type: .genericAction, title: strings.fakePhoneCancel, action: {}),
+            TextAlertAction(type: .defaultAction, title: strings.fakePhoneContinue, action: {
+                runChangeFlow {
+                    store.update { state in
+                        state.fakePhone = true
+                    }
+                }
+            })
+        ])
+        presentImpl?(alert)
+    }, change: {
+        runChangeFlow {
+            store.update { state in
+                state.fakePhone = true
+            }
+        }
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        store.statePromise.get(),
+        numberPromise.get(),
+        switchRevisionPromise.get()
+    )
+    |> map { presentationData, state, number, revision -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [NyxaFakePhoneEntry] = [
+            .header(strings.fakePhoneHeader),
+            .toggle(strings.fakePhoneTitle, isRussian ? "В профиле и настройках покажется другой номер" : "Profile and settings show a different number", state.fakePhone, revision)
+        ]
+        if state.fakePhone {
+            let label = number.flatMap { formatPhoneNumber("+" + $0) } ?? strings.fakePhoneNotSet
+            entries.append(.change(strings.fakePhoneChange, label))
+        }
+        entries.append(.footer(strings.fakePhoneFooter))
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(strings.fakePhoneTitle), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    return controller
+}
