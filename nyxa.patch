+        }
+        return entries(accountPeerId: accountPeerId).compactMap { entry -> StarGift.UniqueGift? in
+            if case let .unique(gift) = ownedGift(entry.gift, accountPeerId: accountPeerId) {
+                return gift
+            }
+            return nil
+        }
