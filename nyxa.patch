+private func nyxaFakeUsernamesController(context: AccountContext, store: NyxaSettingsStore, strings: NyxaStrings) -> ViewController {
+    let isRussian = nyxaIsRussianLocale()
+    let accountPeerId = context.account.peerId
+    let usernamesPromise = ValuePromise<[String]>(NyxaSettings.fakeUsernames(accountPeerId: accountPeerId), ignoreRepeated: true)
+
+    var presentImpl: ((ViewController) -> Void)?
+
+    let update: ([String]) -> Void = { usernames in
+        NyxaSettings.setFakeUsernames(usernames, accountPeerId: accountPeerId)
+        usernamesPromise.set(NyxaSettings.fakeUsernames(accountPeerId: accountPeerId))
+    }
+
+    let arguments = NyxaFakeUsernamesArguments(toggle: { value in
+        store.update { state in
+            state.fakeUsernames = value
+        }
+    }, add: {
+        let prompt = promptController(context: context, text: strings.fakeUsernamesAddTitle, value: "@", placeholder: "@username", characterLimit: 33, apply: { value in
+            let name = String((value ?? "").filter { $0.isLetter || $0.isNumber || $0 == "_" })
+            if name.isEmpty {
+                return
+            }
+            var usernames = NyxaSettings.fakeUsernames(accountPeerId: accountPeerId)
+            if usernames.count >= NyxaSettings.maxFakeUsernames || usernames.contains(where: { $0.lowercased() == name.lowercased() }) {
+                return
+            }
+            usernames.append(name)
+            update(usernames)
+            store.update { state in
+                state.fakeUsernames = true
+            }
+        })
+        presentImpl?(prompt)
+    }, remove: { name in
+        let alert = textAlertController(context: context, title: nil, text: strings.fakeUsernamesRemove(name), actions: [
+            TextAlertAction(type: .genericAction, title: strings.fakePhoneCancel, action: {}),
+            TextAlertAction(type: .destructiveAction, title: strings.fakeUsernamesRemoveAction, action: {
+                update(NyxaSettings.fakeUsernames(accountPeerId: accountPeerId).filter { $0 != name })
+            })
+        ])
+        presentImpl?(alert)
+    })
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        store.statePromise.get(),
+        usernamesPromise.get()
+    )
+    |> map { presentationData, state, usernames -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [NyxaFakeUsernamesEntry] = [
+            .toggle(strings.fakeUsernamesTitle, isRussian ? "Дополнительные юзы в вашем профиле" : "Extra usernames in your profile", state.fakeUsernames),
+            .header(strings.fakeUsernamesHeader(usernames.count, NyxaSettings.maxFakeUsernames))
+        ]
+        for (index, name) in usernames.enumerated() {
+            entries.append(.username(Int32(index), name))
+        }
+        if usernames.count < NyxaSettings.maxFakeUsernames {
+            entries.append(.add(strings.fakeUsernamesAdd))
+        }
+        entries.append(.footer(strings.fakeUsernamesFooter))
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(strings.fakeUsernamesTitle), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    presentImpl = { [weak controller] c in
+        controller?.present(c, in: .window(.root))
+    }
+    return controller
+}
