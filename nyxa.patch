+private struct NyxaFakeStarsState: Equatable {
+    var starsEnabled: Bool
+    var stars: Int64
+    var gramEnabled: Bool
+    var gram: Int64
+}
+
+private func nyxaCurrentFakeStarsState() -> NyxaFakeStarsState {
+    return NyxaFakeStarsState(starsEnabled: NyxaSettings.fakeStarsEnabled, stars: NyxaSettings.fakeStars, gramEnabled: NyxaSettings.fakeGramEnabled, gram: NyxaSettings.fakeGram)
+}
+
+private func nyxaFakeBalanceAmount(progress: CGFloat) -> Int64 {
+    let clamped = max(0.0, min(1.0, Double(progress)))
+    let amount = Int64(pow(10.0, clamped * 6.0).rounded())
+    return max(NyxaSettings.fakeBalanceMinimum, min(NyxaSettings.fakeBalanceMaximum, amount))
+}
+
+private func nyxaFakeBalanceProgress(amount: Int64) -> CGFloat {
+    return CGFloat(log10(Double(max(NyxaSettings.fakeBalanceMinimum, amount))) / 6.0)
+}
+
+private func nyxaGroupedNumber(_ value: Int64, separator: String) -> String {
+    var text = String(value)
+    var offset = text.count - 3
+    while offset > 0 && !separator.isEmpty {
+        text.insert(contentsOf: separator, at: text.index(text.startIndex, offsetBy: offset))
+        offset -= 3
+    }
+    return text
+}
