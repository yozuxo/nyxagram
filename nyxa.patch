+public enum NyxaStreaks {
+    public static let didChangeNotification = Notification.Name("NyxaStreaksDidChange")
+    
+    private static let lock = NSLock()
+    private static var cachedRecords: [String: [Int32]]?
+    
+    public static var enabled: Bool {
+        get { return UserDefaults.standard.bool(forKey: "nyxa.streaks.enabled") }
+        set {
+            UserDefaults.standard.set(newValue, forKey: "nyxa.streaks.enabled")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+    
+    public static var selectedPeerIds: Set<Int64> {
+        get { return nyxaPeerIds(forKey: "nyxa.streaks.peers") }
+        set {
+            nyxaSetPeerIds(newValue, forKey: "nyxa.streaks.peers")
+            NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        }
+    }
+    
+    public static func isEligible(peerId: EnginePeer.Id) -> Bool {
+        if !enabled || peerId.namespace != Namespaces.Peer.CloudUser {
+            return false
+        }
+        let selected = selectedPeerIds
+        return selected.isEmpty || selected.contains(peerId.toInt64())
+    }
+    
+    private static func dayIndex(_ timestamp: Int32) -> Int32 {
+        let offset = Int32(TimeZone.current.secondsFromGMT(for: Date(timeIntervalSince1970: Double(timestamp))))
+        return (timestamp + offset) / 86400
+    }
+    
+    public static func days(peerId: EnginePeer.Id, accountPeerId: EnginePeer.Id, lastMessageTimestamp: Int32?) -> Int32? {
+        if !isEligible(peerId: peerId) {
+            return nil
+        }
+        let key = "\(accountPeerId.toInt64()):\(peerId.toInt64())"
+        let today = dayIndex(Int32(Date().timeIntervalSince1970))
+        
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        var records = cachedRecords ?? (UserDefaults.standard.dictionary(forKey: "nyxa.streaks.records") as? [String: [Int32]] ?? [:])
+        var record = records[key] ?? []
+        var changed = false
+        if record.count != 2 {
+            record = [1, today]
+            changed = true
+        }
+        if let lastMessageTimestamp {
+            let day = dayIndex(lastMessageTimestamp)
+            if day > record[1] && day <= today {
+                record[0] += 1
+                record[1] = day
+                changed = true
+            }
+        }
+        if changed {
+            records[key] = record
+            UserDefaults.standard.set(records, forKey: "nyxa.streaks.records")
+        }
+        cachedRecords = records
+        return record[0]
+    }
+}
